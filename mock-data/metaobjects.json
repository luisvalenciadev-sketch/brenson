  "faq": [
    { "categoria": "general", "pregunta": "¿Necesito licencia de conducción para un vehículo eléctrico?", "respuesta": "Las bicicletas eléctricas con asistencia hasta 25 km/h y motor hasta 350 W no requieren licencia. Ciclomotores, motocarros y cuadriciclos sí requieren licencia y matrícula según la Resolución 160 de 2017 y normas vigentes. [VALIDAR]" },
    { "categoria": "general", "pregunta": "¿Los vehículos eléctricos pagan SOAT?", "respuesta": "Los ciclomotores, motocarros y cuadriciclos matriculados deben tener SOAT. Las bicicletas eléctricas no. [VALIDAR]" },
    { "categoria": "general", "pregunta": "¿Tienen restricción de pico y placa?", "respuesta": "En la mayoría de ciudades colombianas los vehículos eléctricos están exentos de pico y placa. Confirma la norma de tu ciudad. [VALIDAR]" },
    { "categoria": "bateria", "pregunta": "¿Dónde y cómo cargo el vehículo?", "respuesta": "En cualquier toma doméstica de 110 V. Los modelos con batería extraíble se cargan dentro de casa u oficina. El tiempo de carga completo está en la ficha de cada modelo." },
    { "categoria": "bateria", "pregunta": "¿Cuánto cuesta cargar la batería?", "respuesta": "Una carga completa de un ciclomotor típico consume entre 2 y 3 kWh, es decir entre 1.500 y 2.500 pesos según la tarifa de tu ciudad. [VALIDAR]" },
    { "categoria": "bateria", "pregunta": "¿Cuánto dura la batería?", "respuesta": "Las baterías de litio LiFePO4 conservan más del 80 % de su capacidad después de 2.000 ciclos, entre 5 y 7 años de uso normal. La garantía de batería está en cada ficha." },
    { "categoria": "garantia", "pregunta": "¿Qué cubre la garantía Brenson?", "respuesta": "Defectos de fabricación en motor, controlador, batería y estructura durante el periodo indicado en la ficha. No cubre desgaste normal, golpes ni modificaciones. [BORRADOR: términos legales pendientes]" },
    { "categoria": "servicio", "pregunta": "¿Dónde hago el mantenimiento?", "respuesta": "En nuestra sede y en la red de talleres aliados. También coordinamos servicio a domicilio en las principales ciudades. [VALIDAR ciudades]" },
    { "categoria": "compra", "pregunta": "¿Puedo financiar mi vehículo?", "respuesta": "Sí. Usa el simulador de la ficha para ver la cuota estimada y solicita el estudio de crédito con nuestro aliado financiero desde el mismo sitio." },
    { "categoria": "compra", "pregunta": "¿Hacen envíos a toda Colombia?", "respuesta": "Sí. El costo del envío se cotiza según el destino y el tipo de vehículo. Los tiempos estimados por región están en cada ficha." }
