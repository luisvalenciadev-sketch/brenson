{{ 'component-brenson-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #brenson-hero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #050709;
    color: #ffffff;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(0.3) brightness(0.75);
    opacity: 0.4;
    transform: scale(1.05);
    {%- if section.settings.background_image != blank -%}
      background-image: url({{ section.settings.background_image | image_url: width: 1920 }});
    {%- else -%}
      background-color: #1a1e24;
    {%- endif -%}
  }

  #brenson-hero-{{ section.id }} .brenson-hero__overlay-top {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #050709 0%, rgba(5,7,9,0.7) 40%, transparent 100%);
  }

  #brenson-hero-{{ section.id }} .brenson-hero__overlay-side {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(5,7,9,0.9) 0%, rgba(5,7,9,0.5) 50%, transparent 100%);
  }

  #brenson-hero-{{ section.id }} .brenson-hero__content {
    position: relative;
    z-index: 10;
    max-width: 900px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(31,138,76,0.2);
    border: 1px solid rgba(31,138,76,0.5);
    backdrop-filter: blur(8px);
    margin-bottom: 1.5rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__badge-icon {
    font-family: 'Material Symbols Outlined';
    font-variation-settings: 'FILL' 1;
    font-size: 0.9rem;
    color: #25D366;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__heading {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(2rem, 5vw, 3.75rem);
    max-width: 850px;
    margin-bottom: 1.25rem;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__subheading {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    color: #d1d5db;
    max-width: 650px;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__searchbox {
    width: 100%;
    max-width: 780px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    padding: 0.85rem;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.2);
    color: #050709;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__searchbox-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.75rem;
  }

  @media screen and (min-width: 768px) {
    #brenson-hero-{{ section.id }} .brenson-hero__searchbox-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  #brenson-hero-{{ section.id }} .brenson-hero__chips {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    width: 100%;
    flex: 1;
  }

  @media screen and (min-width: 640px) {
    #brenson-hero-{{ section.id }} .brenson-hero__chips {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #brenson-hero-{{ section.id }} .brenson-hero__chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid #E2E5E9;
    background: #F4F5F7;
    color: #050709;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__chip:hover {
    border-color: #050709;
    background: #ffffff;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__chip-icon {
    font-family: 'Material Symbols Outlined';
    font-size: 1.1rem;
    color: #EE0000;
  }

  #brenson-hero-{{ section.id }} .brenson-hero__cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #EE0000;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 0.75rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.15s;
  }

  @media screen and (min-width: 768px) {
    #brenson-hero-{{ section.id }} .brenson-hero__cta {
      width: auto;
    }
  }

  #brenson-hero-{{ section.id }} .brenson-hero__cta:hover {
    background: #C80000;
    transform: scale(1.02);
  }

  #brenson-hero-{{ section.id }} .brenson-hero__cta-icon {
    font-family: 'Material Symbols Outlined';
    font-size: 1rem;
  }
{%- endstyle -%}

<div id="brenson-hero-{{ section.id }}" class="brenson-hero color-{{ section.settings.color_scheme }}">
  <div class="brenson-hero__bg"></div>
  <div class="brenson-hero__overlay-top"></div>
  <div class="brenson-hero__overlay-side"></div>

  <div class="brenson-hero__content">
    {%- if section.settings.badge_text != blank -%}
      <div class="brenson-hero__badge">
        <span class="brenson-hero__badge-icon">verified</span>
        <span>{{ section.settings.badge_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="brenson-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="brenson-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="brenson-hero__searchbox">
      <div class="brenson-hero__searchbox-inner">
        <div class="brenson-hero__chips">
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              
                href="{{ block.settings.link | default: '#' }}"
                class="brenson-hero__chip"
                {{ block.shopify_attributes }}
              >
                <span class="brenson-hero__chip-icon">{{ block.settings.icon }}</span>
                <span>{{ block.settings.label }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="brenson-hero__cta">
            <span>{{ section.settings.cta_text }}</span>
            <span class="brenson-hero__cta-icon">arrow_forward</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brenson Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de fondo"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Altura mínima",
      "default": 660
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del sello",
      "default": "Certificado Brenson · 12 puntos de inspección"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Movilidad eléctrica certificada para tu ciudad y tu negocio"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Bicicletas, ciclomotores, motocarros y cuadriciclos con garantía Brenson y financiación a tu medida en toda Colombia."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón",
      "default": "Ver catálogo"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "pedal_bike", "label": "Bicicleta" },
            { "value": "moped", "label": "Ciclomotor" },
            { "value": "local_shipping", "label": "Motocarro" },
            { "value": "electric_car", "label": "Cuadriciclo" }
          ],
          "default": "pedal_bike"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Bicicletas"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Brenson Hero",
      "blocks": [
        { "type": "category", "settings": { "icon": "pedal_bike", "label": "Bicicletas" } },
        { "type": "category", "settings": { "icon": "moped", "label": "Ciclomotores" } },
        { "type": "category", "settings": { "icon": "local_shipping", "label": "Motocarros" } },
        { "type": "category", "settings": { "icon": "electric_car", "label": "Cuadriciclos" } }
      ]
    }
  ]
}
{% endschema %}