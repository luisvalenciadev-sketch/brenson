{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <svg style="display: none">
    <symbol id="icon-error" viewBox="0 0 13 13">
      <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
      <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
      <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
      <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
    </symbol>
  </svg>
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  {%- comment -%} Brenson: selector Persona / Empresa (decisión I8, pantalla Stitch 05) {%- endcomment -%}
  <div class="brenson-tabs" role="tablist" style="max-width: 32rem; margin: 0 auto 1.5rem" data-brenson-register-type>
    <button type="button" role="tab" class="brenson-tab" aria-selected="true" data-type="personal">Persona</button>
    <button type="button" role="tab" class="brenson-tab" aria-selected="false" data-type="empresa">Empresa <span class="brenson-badge brenson-badge--gris brenson-badge--sm">B2B</span></button>
  </div>
  <div class="brenson-b2b-card" data-brenson-register-empresa hidden style="max-width: 32rem; margin: 0 auto 1.5rem; background: var(--brenson-gris-claro); box-shadow:none">
    <strong>¿Compra para su empresa o requiere factura con NIT?</strong>
    <p class="brenson-muted" style="margin:0; font-size: var(--brenson-text-sm)">Cree su cuenta corporativa con NIT y acceda a precios por volumen, cotizador de flota y asesor dedicado.</p>
    <a class="brenson-btn brenson-btn--carbon brenson-btn--block" href="/pages/empresas-acceso">Registrar mi empresa en Brenson Empresas</a>
  </div>
  <script>
    (function(){var t=document.querySelector('[data-brenson-register-type]'),p=document.querySelector('[data-brenson-register-empresa]'),f=document.querySelector('.customer.register form');if(!t)return;t.addEventListener('click',function(e){var b=e.target.closest('[data-type]');if(!b)return;t.querySelectorAll('[data-type]').forEach(function(x){x.setAttribute('aria-selected',String(x===b))});var emp=b.dataset.type==='empresa';p.hidden=!emp;if(f)f.hidden=emp;});})();
  </script>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <h2 class="form__message" tabindex="-1" autofocus>
        <svg aria-hidden="true" focusable="false">
          <use href="#icon-error" />
        </svg>
        {{ 'templates.contact.form.error_heading' | t }}
      </h2>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#RegisterForm-{{ field }}">
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="field">
      <input
        type="text"
        name="customer[first_name]"
        id="RegisterForm-FirstName"
        {% if form.first_name %}
          value="{{ form.first_name }}"
        {% endif %}
        autocomplete="given-name"
        placeholder="{{ 'customer.register.first_name' | t }}"
      >
      <label for="RegisterForm-FirstName">
        {{ 'customer.register.first_name' | t }}
      </label>
    </div>
    <div class="field">
      <input
        type="text"
        name="customer[last_name]"
        id="RegisterForm-LastName"
        {% if form.last_name %}
          value="{{ form.last_name }}"
        {% endif %}
        autocomplete="family-name"
        placeholder="{{ 'customer.register.last_name' | t }}"
      >
      <label for="RegisterForm-LastName">
        {{ 'customer.register.last_name' | t }}
      </label>
    </div>
    <div class="field">
      <input
        type="email"
        name="customer[email]"
        id="RegisterForm-email"
        {% if form.email %}
          value="{{ form.email }}"
        {% endif %}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="email"
        aria-required="true"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="RegisterForm-email-error"
        {% endif %}
        placeholder="{{ 'customer.register.email' | t }}"
      >
      <label for="RegisterForm-email">
        {{ 'customer.register.email' | t }}
      </label>
    </div>
    {%- if form.errors contains 'email' -%}
      <span id="RegisterForm-email-error" class="form__message">
        <svg aria-hidden="true" focusable="false">
          <use href="#icon-error" />
        </svg>
        {{ form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email }}.
      </span>
    {%- endif -%}
    <div class="field">
      <input
        type="password"
        name="customer[password]"
        id="RegisterForm-password"
        aria-required="true"
        {% if form.errors contains 'password' %}
          aria-invalid="true"
          aria-describedby="RegisterForm-password-error"
        {% endif %}
        placeholder="{{ 'customer.register.password' | t }}"
      >
      <label for="RegisterForm-password">
        {{ 'customer.register.password' | t }}
      </label>
    </div>
    {%- if form.errors contains 'password' -%}
      <span id="RegisterForm-password-error" class="form__message">
        <svg aria-hidden="true" focusable="false">
          <use href="#icon-error" />
        </svg>
        {{ form.errors.translated_fields.password | capitalize }}
        {{ form.errors.messages.password }}.
      </span>
    {%- endif -%}
    {%- comment -%} Brenson: ciudad y uso previsto para segmentación (decisión I8). Se guardan en la nota del cliente; Flow los copia a metafields brenson.ciudad / brenson.uso_previsto {%- endcomment -%}
    <div class="field">
      <input type="text" name="customer[note][Ciudad]" id="RegisterForm-Ciudad" autocomplete="address-level2" placeholder="Ciudad de residencia">
      <label for="RegisterForm-Ciudad">Ciudad de residencia</label>
    </div>
    <div class="field" style="display:block">
      <label for="RegisterForm-Uso" style="position:static; font-size: 1.2rem; margin-bottom: .4rem; display:block">Uso previsto del vehículo</label>
      <select name="customer[note][Uso previsto]" id="RegisterForm-Uso" class="select__select" style="width:100%; min-height: 4.5rem; padding: 0 1.5rem; border: 1px solid rgba(var(--color-foreground), .55); border-radius: var(--inputs-radius); font-family: inherit; font-size: 1.4rem; background: transparent">
        <option value="personal">Personal / urbano</option>
        <option value="comercial">Comercial / independiente</option>
        <option value="logistica">Logística y reparto</option>
      </select>
    </div>
    <label style="display:flex; gap:.6rem; align-items:flex-start; font-size: 1.2rem; margin: 1rem 0">
      <input type="checkbox" required style="margin-top:.2rem">
      <span>Acepto la <a class="link" href="/policies/privacy-policy">política de tratamiento de datos</a> (Ley 1581 de 2012).</span>
    </label>
    <label style="display:flex; gap:.6rem; align-items:flex-start; font-size: 1.2rem; margin: 0 0 1rem">
      <input type="checkbox" name="customer[accepts_marketing]" value="true" style="margin-top:.2rem">
      <span>Quiero recibir novedades, lanzamientos y ofertas de Brenson.</span>
    </label>
    <button>
      {{ 'customer.register.submit' | t }}
    </button>
  {%- endform -%}
  <div class="brenson-b2b-card" style="max-width: 32rem; margin: 2rem auto 0; background: var(--brenson-carbon); color:#fff">
    <strong>Beneficios de tu cuenta Brenson</strong>
    <ul class="brenson-checklist" style="grid-template-columns:1fr; color: rgba(255,255,255,.85)">
      <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Seguimiento de pedidos y despachos</li>
      <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Estado de garantía por unidad (número de serie)</li>
      <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Facturas descargables</li>
      <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Historial de cotizaciones y solicitudes de financiación</li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
