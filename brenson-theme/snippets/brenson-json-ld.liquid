{%- comment -%}
  brenson-json-ld — Módulo 13. Datos estructurados:
   - Organization en todas las páginas
   - Product/Offer con additionalProperty (specs) en fichas
   - BreadcrumbList en fichas y colecciones
  FAQPage lo emite brenson-faq. Dawn ya emite Product básico en main-product; este snippet lo enriquece
  y Dawn's se puede desactivar si duplica (ver docs).
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.logo -%}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{%- endif -%}
  "contactPoint": [{ "@type": "ContactPoint", "telephone": "+{{ settings.brenson_whatsapp }}", "contactType": "sales", "areaServed": "CO", "availableLanguage": ["es"] }],
  "address": { "@type": "PostalAddress", "addressCountry": "CO", "addressLocality": "Cali", "streetAddress": "Calle 29 #4B-28, B/ Porvenir" }
}
</script>
{%- if request.page_type == 'product' -%}
{%- liquid
  assign mf = product.metafields.brenson
  assign v = product.selected_or_first_available_variant
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "image": [{%- for img in product.images limit: 5 -%}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  "sku": {{ v.sku | json }},
  "category": {{ mf.categoria.value | json }},
  "additionalProperty": [
    {%- if mf.autonomia_km.value -%}{ "@type": "PropertyValue", "name": "Autonomía", "value": {{ mf.autonomia_km.value | json }}, "unitCode": "KMT" },{%- endif -%}
    {%- if mf.velocidad_max_kmh.value -%}{ "@type": "PropertyValue", "name": "Velocidad máxima", "value": {{ mf.velocidad_max_kmh.value | json }}, "unitCode": "KMH" },{%- endif -%}
    {%- if mf.capacidad_carga_kg.value -%}{ "@type": "PropertyValue", "name": "Capacidad de carga", "value": {{ mf.capacidad_carga_kg.value | json }}, "unitCode": "KGM" },{%- endif -%}
    {%- if mf.potencia_motor_w.value -%}{ "@type": "PropertyValue", "name": "Potencia", "value": {{ mf.potencia_motor_w.value | json }}, "unitCode": "WTT" },{%- endif -%}
    { "@type": "PropertyValue", "name": "Batería", "value": {{ mf.bateria_tipo.value | append: ' ' | append: mf.bateria_capacidad.value | strip | json }} }
  ],
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": "COP",
    "price": {{ v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    {%- if mf.garantia_meses.value -%},
    "warranty": { "@type": "WarrantyPromise", "durationOfWarranty": { "@type": "QuantitativeValue", "value": {{ mf.garantia_meses.value | json }}, "unitCode": "MON" } }
    {%- endif -%}
  }
}
</script>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ shop.url | json }} },
  {%- if collection -%}{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} },{%- endif -%}
  { "@type": "ListItem", "position": {% if collection %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
] }
</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ shop.url | json }} },
  { "@type": "ListItem", "position": 2, "name": "Vehículos", "item": {{ shop.url | append: routes.all_products_collection_url | json }} },
  { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
] }
</script>
{%- endif -%}