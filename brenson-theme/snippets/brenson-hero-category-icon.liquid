{%- comment -%}
  brenson-hero-category-icon
  Icono de línea para cada categoría del hero cuando el bloque no trae un icono propio.
  Parámetros: key ('bicicleta' | 'ciclomotor' | 'motocarro' | 'cuadriciclo' | 'patineta')
{%- endcomment -%}
{%- case key -%}
  {%- when 'ciclomotor' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5.5" cy="17.5" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="18.5" cy="17.5" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M5.5 17.5H10.5L13.5 10H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.5 17.5 14 12.5 18.5 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.5 10H15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'motocarro' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5.5" cy="18" r="2.6" stroke="currentColor" stroke-width="1.6"/><circle cx="18.5" cy="18" r="2.6" stroke="currentColor" stroke-width="1.6"/><path d="M8 18H16V9.5C16 8.5 15.3 8 14.5 8H11L8 12.5V18Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M16 12H19.5L21 15V18H16" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'cuadriciclo' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="9" width="17" height="8" rx="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M6 9 8.5 5.5H15.5L18 9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7.5" cy="17.3" r="1.7" fill="currentColor"/><circle cx="16.5" cy="17.3" r="1.7" fill="currentColor"/></svg>
  {%- when 'patineta' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><path d="M5 19H17L19 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7.5 19 14 6H17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12.5 10.5H16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="6" cy="17" r="3.4" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="17" r="3.4" stroke="currentColor" stroke-width="1.6"/><path d="M6 17 10 8H14M10 8 13.5 14H18M13.5 14 16.5 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
