{%- comment -%}
  brenson-product-block — bloques Brenson para main-product (Módulo 04).
  Se invoca desde sections/main-product.liquid con: {% render 'brenson-product-block', block: block, product: product, section: section %}
  Tipos: brenson_certificado · brenson_specs_clave · brenson_precio · brenson_cta_whatsapp · brenson_cta_cotizar · brenson_micro_garantias
{%- endcomment -%}
{%- assign mf = product.metafields.brenson -%}
{%- case block.type -%}

  {%- when 'brenson_certificado' -%}
    <div class="brenson-pb brenson-pb--certificado" {{ block.shopify_attributes }}>
      {%- render 'brenson-badge', product: product, type: 'certificado', size: 'md', expandable: true -%}
    </div>

  {%- when 'brenson_specs_clave' -%}
    {%- if mf.autonomia_km.value or mf.velocidad_max_kmh.value or mf.capacidad_carga_kg.value -%}
      <ul class="brenson-pb brenson-pb__specs" role="list" aria-label="Especificaciones clave" {{ block.shopify_attributes }}>
        {%- if mf.autonomia_km.value -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M21 10v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="m11 9-2 3h3l-2 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><strong>{{ mf.autonomia_km.value }} km</strong><span>{{ 'brenson.autonomia' | t }}</span></li>
        {%- endif -%}
        {%- if mf.velocidad_max_kmh.value -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14a8 8 0 1 1 16 0" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m12 14 3.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><strong>{{ mf.velocidad_max_kmh.value }} km/h</strong><span>{{ 'brenson.velocidad' | t }}</span></li>
        {%- endif -%}
        {%- if mf.capacidad_carga_kg.value -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16 8 8h8l4 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M3 19h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><strong>{{ mf.capacidad_carga_kg.value }} kg</strong><span>{{ 'brenson.carga' | t }}</span></li>
        {%- endif -%}
      </ul>
    {%- endif -%}

  {%- when 'brenson_precio' -%}
    <div class="brenson-pb brenson-pb--precio" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
      {%- render 'brenson-price', product: product, layout: 'full' -%}
      {%- if product.selected_or_first_available_variant.available == false -%}
        <span class="brenson-status brenson-status--muted" style="margin-top:0.8rem">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>

  {%- when 'brenson_cta_whatsapp' -%}
    <div class="brenson-pb" {{ block.shopify_attributes }}>
      <a class="brenson-btn brenson-btn--whatsapp brenson-btn--lg brenson-btn--block" href="{% render 'brenson-whatsapp-link', context: 'product', product: product %}" target="_blank" rel="noopener" data-brenson-track="whatsapp_click" data-brenson-source="pdp_primary" data-brenson-product="{{ product.handle }}">
        <svg class="brenson-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.5-.3Z"/></svg>
        {{ block.settings.label | default: settings.brenson_whatsapp_label | default: 'Hablar con un asesor' }}
      </a>
    </div>

  {%- when 'brenson_cta_cotizar' -%}
    <div class="brenson-pb" {{ block.shopify_attributes }}>
      <a class="brenson-btn brenson-btn--outline-red brenson-btn--lg brenson-btn--block" href="#brenson-lead-form" data-brenson-track="quote_cta">{{ block.settings.label | default: 'Solicitar cotización' }}</a>
    </div>

  {%- when 'brenson_micro_garantias' -%}
    <ul class="brenson-pb brenson-pb__micro" role="list" {{ block.shopify_attributes }}>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Garantía <strong>{{ mf.garantia_meses.value | default: 12 }} meses</strong> vehículo · <strong>{{ mf.garantia_bateria_meses.value | default: 12 }} meses</strong> batería</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="18" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>Envíos a toda Colombia · <a class="link" href="#garantia">ver tiempos por región</a></span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>Prueba de manejo en sede o a domicilio · <a class="link" href="#brenson-lead-form">agendar</a></span></li>
      {%- if mf.requiere_licencia.value -%}
        <li class="brenson-muted"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M14 10h4M14 14h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>Requiere licencia{% if mf.requiere_soat.value %} y SOAT{% endif %}</span></li>
      {%- endif -%}
    </ul>
{%- endcase -%}

<style>
  .brenson-pb { margin-bottom: 1.92rem; }
  .brenson-pb__specs { list-style: none; padding: 0; margin: 0 0 1.92rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .brenson-pb__specs li { display: flex; flex-direction: column; align-items: flex-start; gap: 0.32rem; padding: 1.2rem; border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius); font-size: var(--brenson-text-xs); color: var(--brenson-gris); }
  .brenson-pb__specs svg { width: 2rem; height: 2rem; color: var(--brenson-rojo); }
  .brenson-pb__specs strong { font-size: var(--brenson-text-md); color: var(--brenson-carbon); font-weight: 700; }
  .brenson-pb__micro { list-style: none; padding: 1.44rem 0 0; margin: 0 0 1.92rem; border-top: 1px solid var(--brenson-gris-borde); display: grid; gap: 0.96rem; font-size: var(--brenson-text-sm); }
  .brenson-pb__micro li { display: flex; gap: 0.96rem; align-items: flex-start; }
  .brenson-pb__micro svg { flex: none; width: 1.92rem; height: 1.92rem; color: var(--brenson-certificado); margin-top: 0.16rem; }
</style>