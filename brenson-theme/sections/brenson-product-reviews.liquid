{%- comment -%}
  brenson-product-reviews — Resumen de calificación + reseñas reales del producto + formulario de captura.
  Fuente: product.metafields.brenson.resenas (lista de metaobjects brenson_resena). El worker (/review) crea
  cada reseña en BORRADOR y la agrega a esa lista; el storefront solo recibe las entradas activas, así que una
  reseña aparece cuando Brenson la publica en Admin → Contenido → Metaobjects (moderación).
  Promedio y distribución se calculan aquí con las reseñas publicadas: no hay cifras fijas.
  "Compra verificada" solo se muestra si Brenson marcó el campo al cruzar la reseña con un pedido.
{%- endcomment -%}
{%- liquid
  assign resenas = product.metafields.brenson.resenas.value
  assign total = 0
  assign suma = 0
  assign c1 = 0
  assign c2 = 0
  assign c3 = 0
  assign c4 = 0
  assign c5 = 0
  for r in resenas
    assign cal = r.calificacion.value | plus: 0
    if cal >= 1 and cal <= 5
      assign total = total | plus: 1
      assign suma = suma | plus: cal
      case cal
        when 1
          assign c1 = c1 | plus: 1
        when 2
          assign c2 = c2 | plus: 1
        when 3
          assign c3 = c3 | plus: 1
        when 4
          assign c4 = c4 | plus: 1
        when 5
          assign c5 = c5 | plus: 1
      endcase
    endif
  endfor
  if total > 0
    assign promedio = suma | times: 1.0 | divided_by: total | round: 1
  endif
  assign conteos = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ','
-%}
<section class="brenson-section brenson-product-reviews" id="opiniones">
  <div class="brenson-container brenson-reviews__grid">
    <div class="brenson-reviews__summary">
      <h2 class="brenson-heading" style="font-size: var(--brenson-text-xl); margin-bottom: 0.32rem;">{{ section.settings.title }}</h2>
      <p class="brenson-muted" style="font-size: var(--brenson-text-xs); margin: 0;">{{ product.title }}</p>
      {%- if total > 0 -%}
        <div class="brenson-reviews__score">
          <span class="brenson-reviews__avg">{{ promedio }}</span>
          <div>
            {%- render 'brenson-stars', value: promedio -%}
            <p class="brenson-muted" style="font-size: var(--brenson-text-xs); font-weight: 600; margin: 0.16rem 0 0;">Basado en {{ total }} {% if total == 1 %}opinión publicada{% else %}opiniones publicadas{% endif %}</p>
          </div>
        </div>
        <div class="brenson-reviews__bars">
          {%- for n in conteos -%}
            {%- assign estrellas = forloop.index0 | times: -1 | plus: 5 -%}
            {%- assign pct = n | times: 100 | divided_by: total -%}
            <div class="brenson-reviews__bar-row">
              <span>{{ estrellas }} est.</span>
              <div class="brenson-reviews__bar"><div style="width: {{ pct }}%"></div></div>
              <span class="brenson-reviews__pct">{{ pct }}%</span>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="brenson-reviews__empty">Aún no hay opiniones publicadas de este producto. Si ya lo tienes, cuéntanos tu experiencia.</p>
      {%- endif -%}
      <button type="button" class="brenson-btn brenson-btn--outline brenson-btn--sm brenson-reviews__write" data-brenson-review-open aria-controls="brenson-review-dialog" data-brenson-track="write_review_click">{{ section.settings.write_review_label }}</button>
      <p class="brenson-muted" style="font-size: var(--brenson-text-xs); margin-top: var(--brenson-space-3);">Las opiniones se publican después de una revisión del equipo Brenson.</p>
    </div>

    {%- if total > 0 -%}
      <ul class="brenson-reviews__list" role="list">
        {%- for r in resenas -%}
          {%- assign cal = r.calificacion.value | plus: 0 -%}
          {%- if cal >= 1 and cal <= 5 -%}
            {%- liquid
              assign palabras = r.nombre.value | split: ' '
              assign iniciales = ''
              for p in palabras limit: 2
                assign iniciales = iniciales | append: p | slice: 0, 1
              endfor
            -%}
            <li class="brenson-review-card">
              <div class="brenson-review-card__head">
                <div class="brenson-review-card__who">
                  <span class="brenson-review-card__avatar" aria-hidden="true">{{ iniciales | upcase }}</span>
                  <div>
                    <h3>{{ r.nombre.value | escape }}</h3>
                    {%- if r.compra_verificada.value -%}
                      <span class="brenson-review-card__verificado">
                        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="m9 12 2 2 4-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                        Compra verificada{% if r.ciudad.value != blank %} · {{ r.ciudad.value | escape }}{% endif %}
                      </span>
                    {%- elsif r.ciudad.value != blank -%}
                      <span class="brenson-review-card__ciudad">{{ r.ciudad.value | escape }}</span>
                    {%- endif -%}
                  </div>
                </div>
                {%- if r.fecha.value -%}<time class="brenson-review-card__fecha" datetime="{{ r.fecha.value | date: '%Y-%m-%d' }}">{{ r.fecha.value | date: '%d/%m/%Y' }}</time>{%- endif -%}
              </div>
              {%- render 'brenson-stars', value: cal, size: 'sm' -%}
              {%- if r.titulo.value != blank -%}<p class="brenson-review-card__titulo">{{ r.titulo.value | escape }}</p>{%- endif -%}
              <p class="brenson-review-card__texto">&ldquo;{{ r.texto.value | escape | newline_to_br }}&rdquo;</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <dialog class="brenson-review-dialog" id="brenson-review-dialog" aria-labelledby="brenson-review-title">
    <form method="dialog" class="brenson-review-dialog__close"><button aria-label="Cerrar">×</button></form>
    <form class="brenson-form" data-brenson-review-form data-endpoint="{{ settings.brenson_services_url }}" data-product-id="{{ product.id }}" novalidate>
      <h2 id="brenson-review-title" style="margin:0; font-size: var(--brenson-text-xl)">Tu opinión sobre {{ product.title }}</h2>
      <fieldset class="brenson-field brenson-review-stars-input">
        <legend>Calificación *</legend>
        <div class="brenson-review-stars-input__row">
          {%- for i in (1..5) reversed -%}
            <input type="radio" id="review-cal-{{ i }}" name="calificacion" value="{{ i }}" required>
            <label for="review-cal-{{ i }}" title="{{ i }} de 5"><span class="brenson-visually-hidden">{{ i }} de 5 estrellas</span>★</label>
          {%- endfor -%}
        </div>
      </fieldset>
      <div class="brenson-form__row brenson-form__row--2">
        <div class="brenson-field">
          <label for="review-nombre">Nombre *</label>
          <input id="review-nombre" name="nombre" type="text" required minlength="2" maxlength="80" autocomplete="name" placeholder="Ej. Ana R.">
        </div>
        <div class="brenson-field">
          <label for="review-ciudad">Ciudad</label>
          <input id="review-ciudad" name="ciudad" type="text" maxlength="80" placeholder="Ej. Cali">
        </div>
      </div>
      <div class="brenson-field">
        <label for="review-titulo">Título</label>
        <input id="review-titulo" name="titulo" type="text" maxlength="120" placeholder="Resume tu experiencia">
      </div>
      <div class="brenson-field">
        <label for="review-texto">Tu opinión *</label>
        <textarea id="review-texto" name="texto" required minlength="10" maxlength="1500" rows="4" placeholder="¿Cómo te ha ido con el producto?"></textarea>
      </div>
      <div class="brenson-field">
        <label for="review-email">Correo (opcional, no se publica)</label>
        <input id="review-email" name="email" type="email" maxlength="160" autocomplete="email" placeholder="tucorreo@ejemplo.com">
      </div>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="brenson-visually-hidden" aria-hidden="true">
      <label style="display:flex; gap:0.8rem; align-items:flex-start; font-size: var(--brenson-text-xs)">
        <input type="checkbox" name="acepta" required style="margin-top:0.24rem">
        <span>Autorizo publicar mi nombre, ciudad y opinión, y el tratamiento de mis datos según la <a class="link" href="/policies/privacy-policy">política de privacidad</a> de Brenson S.A.S.</span>
      </label>
      <div data-turnstile-slot></div>
      <button type="submit" class="brenson-btn brenson-btn--primary brenson-btn--block" data-review-submit>Enviar opinión</button>
      <p class="brenson-form__success" data-review-success hidden role="status">¡Gracias! Recibimos tu opinión (radicado <span data-review-id></span>). La publicaremos después de revisarla.</p>
      <p class="brenson-form__error" data-review-error hidden role="alert"></p>
    </form>
  </dialog>
</section>
<script src="{{ 'brenson-reviews.js' | asset_url }}" defer></script>
<style>
  .brenson-reviews__grid { display: grid; gap: var(--brenson-space-8); }
  @media (min-width: 990px) { .brenson-reviews__grid { grid-template-columns: 0.85fr 1.6fr; align-items: start; } }
  .brenson-reviews__summary { background: var(--brenson-gris-claro); border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-xl); padding: var(--brenson-space-6); }
  .brenson-reviews__score { display: flex; align-items: baseline; gap: var(--brenson-space-3); margin: var(--brenson-space-4) 0; }
  .brenson-reviews__avg { font-size: var(--brenson-text-4xl); font-weight: 800; line-height: 1; color: var(--brenson-carbon); }
  .brenson-reviews__stars { color: #f5b301; letter-spacing: .1em; font-size: var(--brenson-text-md); }
  .brenson-reviews__stars--sm { font-size: var(--brenson-text-sm); }
  .brenson-reviews__stars-off { color: var(--brenson-gris-borde); }
  .brenson-reviews__empty { margin: var(--brenson-space-4) 0 0; font-size: var(--brenson-text-sm); color: var(--brenson-carbon-60); }
  .brenson-reviews__bars { display: flex; flex-direction: column; gap: var(--brenson-space-2); margin-top: var(--brenson-space-3); }
  .brenson-reviews__bar-row { display: flex; align-items: center; gap: var(--brenson-space-2); font-size: var(--brenson-text-xs); }
  .brenson-reviews__bar-row > span:first-child { width: 4.8rem; color: var(--brenson-carbon-60); font-weight: 600; }
  .brenson-reviews__bar { flex: 1; background: var(--brenson-gris-borde); border-radius: 999px; height: 0.64rem; overflow: hidden; }
  .brenson-reviews__bar div { background: var(--brenson-certificado); height: 100%; border-radius: 999px; }
  .brenson-reviews__pct { font-weight: 700; color: var(--brenson-carbon); min-width: 3.2rem; text-align: right; }
  .brenson-reviews__write { width: 100%; margin-top: var(--brenson-space-5); }
  .brenson-reviews__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--brenson-space-4); }
  .brenson-review-card { background: #fff; border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-lg); padding: var(--brenson-space-6); display: flex; flex-direction: column; gap: var(--brenson-space-3); }
  .brenson-review-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--brenson-space-3); }
  .brenson-review-card__who { display: flex; align-items: center; gap: var(--brenson-space-3); }
  .brenson-review-card__avatar { width: 4rem; height: 4rem; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--brenson-carbon); font-weight: 800; font-size: var(--brenson-text-xs); flex-shrink: 0; }
  .brenson-review-card__who h3 { margin: 0; font-size: var(--brenson-text-sm); font-weight: 700; color: var(--brenson-carbon); }
  .brenson-review-card__verificado { display: inline-flex; align-items: center; gap: 0.32rem; font-size: var(--brenson-text-xs); font-weight: 600; color: var(--brenson-certificado); margin-top: 0.16rem; }
  .brenson-review-card__ciudad { font-size: var(--brenson-text-xs); color: var(--brenson-carbon-60); }
  .brenson-review-card__fecha { font-size: var(--brenson-text-xs); color: var(--brenson-carbon-60); white-space: nowrap; }
  .brenson-review-card__titulo { margin: 0; font-weight: 700; font-size: var(--brenson-text-sm); color: var(--brenson-carbon); }
  .brenson-review-card__texto { margin: 0; font-size: var(--brenson-text-sm); line-height: 1.6; color: var(--brenson-carbon-60); }
  .brenson-review-dialog { width: min(56rem, calc(100vw - 3.2rem)); border: 0; border-radius: var(--brenson-radius-xl); padding: var(--brenson-space-6); }
  .brenson-review-dialog::backdrop { background: rgb(0 0 0 / .55); }
  .brenson-review-dialog .brenson-form { display: flex; flex-direction: column; gap: var(--brenson-space-4); }
  .brenson-review-dialog__close { position: absolute; top: 0.8rem; right: 0.8rem; }
  .brenson-review-dialog__close button { background: none; border: 0; font-size: 2.4rem; line-height: 1; cursor: pointer; color: var(--brenson-carbon-60); }
  .brenson-review-stars-input { border: 0; padding: 0; margin: 0; }
  .brenson-review-stars-input legend { font-weight: 600; font-size: var(--brenson-text-sm); margin-bottom: 0.4rem; }
  .brenson-review-stars-input__row { display: inline-flex; flex-direction: row-reverse; gap: 0.4rem; }
  .brenson-review-stars-input__row input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .brenson-review-stars-input__row label { font-size: 3.2rem; line-height: 1; color: var(--brenson-gris-borde); cursor: pointer; }
  .brenson-review-stars-input__row input:checked ~ label,
  .brenson-review-stars-input__row label:hover,
  .brenson-review-stars-input__row label:hover ~ label { color: #f5b301; }
  .brenson-review-stars-input__row input:focus-visible + label { outline: 2px solid var(--brenson-carbon); outline-offset: 2px; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Brenson · Reseñas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Opiniones de compradores" },
    { "type": "text", "id": "write_review_label", "label": "Texto del botón", "default": "Escribir una opinión" },
    { "type": "paragraph", "content": "Las reseñas llegan en borrador a Contenido → Metaobjects → Reseña de producto. Al publicarlas aparecen en la ficha. Marca \"Compra verificada\" solo tras cruzarla con un pedido." }
  ],
  "presets": [ { "name": "Brenson · Reseñas" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
