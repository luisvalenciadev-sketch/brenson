{%- comment -%}
  brenson-hero — Módulo 01. Hero con video en loop o imagen (decisión G2), titular, buscador rápido por categoría y CTA.
  Simulación: si no hay video/imagen cargada se muestra un fondo degradado carbón (S2).
{%- endcomment -%}
{{ 'brenson-hero.css' | asset_url | stylesheet_tag }}

<section class="brenson-hero color-{{ section.settings.color_scheme }}" style="--hero-min-height: {{ section.settings.min_height }}vh;">
  <div class="brenson-hero__media" aria-hidden="true">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'brenson-hero__video', image_size: '1440x' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1440, 1920, 2400', class: 'brenson-hero__image' }}
    {%- else -%}
      <div class="brenson-hero__placeholder"></div>
    {%- endif -%}
    <div class="brenson-hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="brenson-container brenson-hero__content">
    {%- if section.settings.show_certificado and settings.brenson_show_certificado -%}
      <span class="brenson-badge brenson-badge--certificado brenson-badge--md brenson-hero__badge">
        <svg class="brenson-badge__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m13 7-4 6h3l-1 4 4-6h-3l1-4Z" fill="currentColor"/></svg>
        {{ 'brenson.certificado' | t }} · {{ 'brenson.puntos_inspeccion' | t: count: settings.brenson_certificado_puntos }}
      </span>
    {%- endif -%}

    <h1 class="brenson-hero__title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="brenson-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="brenson-hero__quick" aria-label="Buscar por categoría">
        <ul class="brenson-hero__chips">
          {%- for block in section.blocks -%}
            {%- if block.type == 'categoria' and block.settings.collection != blank -%}
              <li {{ block.shopify_attributes }}>
                <a class="brenson-hero__chip" href="{{ block.settings.collection.url }}">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-8 12h6l-1 8 8-12h-6l1-8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                  <span>{{ block.settings.label | default: block.settings.collection.title }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.cta_url != blank -%}
            <li><a class="brenson-btn brenson-btn--primary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a></li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Brenson · Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "video", "id": "video", "label": "Video de fondo (loop)", "info": "Recomendado: 10 a 20 s, sin audio, 1920x1080. Si no hay video se usa la imagen." },
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo (fallback)" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Oscurecer fondo", "default": 55 },
    { "type": "range", "id": "min_height", "min": 50, "max": 100, "step": 5, "unit": "vh", "label": "Altura mínima", "default": 85 },
    { "type": "checkbox", "id": "show_certificado", "label": "Mostrar badge Certificado Brenson", "default": true },
    { "type": "text", "id": "title", "label": "Titular", "default": "Movilidad eléctrica certificada para tu ciudad y tu negocio" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Bicicletas, ciclomotores, motocarros y cuadriciclos con garantía Brenson y financiación a tu medida." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Ver catálogo" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar enlace a WhatsApp", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "label", "label": "Texto (opcional)" },
        { "type": "image_picker", "id": "icon", "label": "Icono (opcional, SVG/PNG 48px)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brenson · Hero",
      "blocks": [
        { "type": "categoria", "settings": { "label": "Bicicletas" } },
        { "type": "categoria", "settings": { "label": "Ciclomotores" } },
        { "type": "categoria", "settings": { "label": "Motocarros" } },
        { "type": "categoria", "settings": { "label": "Cuadriciclos" } },
        { "type": "categoria", "settings": { "label": "Patinetas" } }
      ]
    }
  ]
}
{% endschema %}