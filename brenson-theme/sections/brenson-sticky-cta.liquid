{%- comment -%}
  brenson-sticky-cta — Módulo 17 (mobile). Barra fija inferior en la ficha: cuota + precio + WhatsApp (decisión H9).
  Se sincroniza con el simulador vía [data-brenson-price].
{%- endcomment -%}
{%- if request.page_type == 'product' -%}
<div class="brenson-sticky-bar" data-brenson-sticky-bar>
  {%- render 'brenson-price', product: product, layout: 'card' -%}
  <a class="brenson-btn brenson-btn--whatsapp" href="{% render 'brenson-whatsapp-link', context: 'product', product: product %}" target="_blank" rel="noopener" data-brenson-track="whatsapp_click" data-brenson-source="sticky" data-brenson-product="{{ product.handle }}" aria-label="Hablar con un asesor por WhatsApp">
    <svg class="brenson-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.5-.3Z"/></svg>
    Asesor
  </a>
</div>
<script>document.body.classList.add('has-brenson-sticky-bar');</script>
{%- endif -%}

{% schema %}
{
  "name": "Brenson · Sticky bar mobile",
  "tag": "div",
  "settings": [ { "type": "paragraph", "content": "Visible solo en móvil en la ficha de producto. Muestra cuota, precio y WhatsApp en la zona del pulgar." } ],
  "presets": [ { "name": "Brenson · Sticky bar mobile" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}