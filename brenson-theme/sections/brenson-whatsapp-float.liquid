{%- comment -%}
  brenson-whatsapp-float — Módulo 10. Botón flotante con mensaje dinámico por página y estado de horario.
  Se agrega en el grupo overlay (header-group) para que aparezca en todo el sitio.
  Contexto: product → mensaje con modelo; page.empresas / collection empresas → mensaje formal; resto → default.
  Estado en línea / fuera de horario se calcula en JS con settings de horario (S11: sin API de WhatsApp, solo wa.me).
{%- endcomment -%}
{%- liquid
  assign ctx = 'default'
  if request.page_type == 'product'
    assign ctx = 'product'
  elsif template.suffix == 'empresas' or template.suffix == 'empresas-acceso' or template.suffix == 'cotizador'
    assign ctx = 'empresas'
  endif
-%}
{%- unless request.page_type == 'cart' -%}
<a
  class="brenson-wa-float"
  href="{% render 'brenson-whatsapp-link', context: ctx, product: product %}"
  target="_blank"
  rel="noopener"
  aria-label="{{ settings.brenson_whatsapp_label | default: 'Hablar con un asesor' }} por WhatsApp"
  data-brenson-wa-float
  data-brenson-track="whatsapp_click"
  data-brenson-source="float"
  data-horario-semana="{{ settings.brenson_horario_semana }}"
  data-horario-sabado="{{ settings.brenson_horario_sabado }}"
  data-horario-domingo="{{ settings.brenson_horario_domingo }}"
  data-label-online="{{ 'brenson.en_linea' | t }}"
  data-label-closed="{{ 'brenson.fuera_horario' | t }}"
  data-status="open"
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.5-.3Z"/></svg>
  <span class="brenson-wa-float__text">
    {{ settings.brenson_whatsapp_label | default: 'Hablar con un asesor' }}
    <span class="brenson-wa-float__status" data-brenson-wa-status>{{ 'brenson.en_linea' | t }}</span>
  </span>
</a>
<script src="{{ 'brenson-whatsapp.js' | asset_url }}" defer></script>
{%- endunless -%}

{%- if settings.brenson_modo_simulacion -%}
  <div class="brenson-sim-banner" role="status">{{ 'brenson.modo_simulacion_aviso' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Brenson · WhatsApp flotante",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Número, textos y horario se configuran en Ajustes del tema → Brenson · Contacto y WhatsApp." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}