{%- comment -%}
  brenson-product-certification — Módulo 06. Sello Certificado Brenson con checklist de 12 puntos.
  Layout: sello grande + stats a la izquierda, grid de puntos individuales a la derecha (Stitch 14).
  Checklist desde metaobject brenson_certificacion (S5) referenciado por el producto o el primero disponible.
  Se oculta si settings.brenson_show_certificado es false (riesgo R-D3) o si el producto no está certificado.
{%- endcomment -%}
{%- liquid
  assign cert = product.metafields.brenson.certificacion.value
  if cert == blank
    assign cert = shop.metaobjects.brenson_certificacion.values | first
  endif
  assign show = settings.brenson_show_certificado
  if product.metafields.brenson.certificado.value == false
    assign show = false
  endif
  assign checklist = nil
  assign puntos = settings.brenson_certificado_puntos
  assign descripcion = section.settings.text
  if cert
    assign checklist = cert.checklist.value
    if cert.puntos_inspeccion.value
      assign puntos = cert.puntos_inspeccion.value
    endif
    if cert.descripcion.value != blank
      assign descripcion = cert.descripcion.value
    endif
  endif
  unless checklist
    assign checklist = 'Diagnóstico de batería: capacidad, celdas y BMS|Prueba de motor y controlador bajo carga|Calibración de acelerador y frenos regenerativos|Revisión y ajuste de frenos|Torque de tornillería estructural|Presión y estado de llantas|Luces, señalización y bocina|Suspensión y dirección|Cargador y conector verificados|Prueba de ruta de 5 km|Actualización de firmware|Limpieza, protección y entrega documentada' | split: '|'
  endunless
-%}
{%- if show -%}
<section id="brenson-certificacion" class="brenson-section brenson-certification">
  <div class="brenson-container">
    <header class="brenson-section__head" style="text-align:left; max-width:none;">
      <span class="brenson-eyebrow" style="color: var(--brenson-certificado)">{{ section.settings.eyebrow }}</span>
      <h2 class="brenson-heading">{{ section.settings.title }}</h2>
      <p class="brenson-subheading">{{ descripcion }}</p>
    </header>
    <div class="brenson-certification__grid">
      <div class="brenson-certification__seal">
        <div class="brenson-certification__seal-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        </div>
        <span class="brenson-certification__seal-tag">Protocolo certificado</span>
        <strong>{{ 'brenson.puntos_inspeccion' | t: count: puntos }}</strong>
        <p>{{ section.settings.seal_text }}</p>
        <div class="brenson-certification__seal-stats">
          <div><strong>100 %</strong><span>Celdas auditadas</span></div>
          <div><strong>0 km</strong><span>Prueba de ruta</span></div>
        </div>
      </div>
      <ul class="brenson-certification__points" role="list">
        {%- for item in checklist -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span>{{ forloop.index }}. {{ item }}</span></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
<style>
  .brenson-certification__grid { display: grid; gap: var(--brenson-space-8); align-items: center; margin-top: var(--brenson-space-8); }
  @media (min-width: 990px) { .brenson-certification__grid { grid-template-columns: 1fr 2fr; } }
  .brenson-certification__seal { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.56rem; padding: var(--brenson-space-8) var(--brenson-space-6); background: var(--brenson-certificado-suave); border: 2px solid var(--brenson-certificado); border-radius: var(--brenson-radius-xl); }
  .brenson-certification__seal-icon { width: 9.6rem; height: 9.6rem; border-radius: 50%; background: var(--brenson-certificado); color: #fff; display: grid; place-items: center; box-shadow: 0 12px 24px rgba(31,138,76,.25); margin-bottom: var(--brenson-space-2); }
  .brenson-certification__seal-icon svg { width: 5.6rem; height: 5.6rem; }
  .brenson-certification__seal-tag { display:inline-block; background:#fff; color: var(--brenson-certificado); font-size: var(--brenson-text-xs); font-weight: 800; text-transform: uppercase; letter-spacing: .04em; padding: 0.4rem 1.12rem; border-radius: 999px; border: 1px solid var(--brenson-certificado); }
  .brenson-certification__seal strong { font-size: var(--brenson-text-xl); font-weight: 800; color: var(--brenson-carbon); }
  .brenson-certification__seal p { margin:0; font-size: var(--brenson-text-xs); color: var(--brenson-carbon-60); max-width: 24rem; }
  .brenson-certification__seal-stats { display:flex; justify-content: space-around; width: 100%; margin-top: var(--brenson-space-4); padding-top: var(--brenson-space-4); border-top: 1px solid rgba(31,138,76,.25); }
  .brenson-certification__seal-stats strong { display:block; font-size: var(--brenson-text-lg); font-weight: 800; color: var(--brenson-carbon); }
  .brenson-certification__seal-stats span { font-size: var(--brenson-text-xs); color: var(--brenson-carbon-60); }
  .brenson-certification__points { list-style:none; margin:0; padding:0; display:grid; gap: var(--brenson-space-3); grid-template-columns: 1fr; }
  @media (min-width: 750px) { .brenson-certification__points { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) { .brenson-certification__points { grid-template-columns: repeat(3, 1fr); } }
  .brenson-certification__points li { display:flex; align-items:flex-start; gap: 0.8rem; background: var(--brenson-gris-claro); border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-lg); padding: var(--brenson-space-4); font-size: var(--brenson-text-sm); font-weight: 600; color: var(--brenson-carbon); }
  .brenson-certification__points svg { flex-shrink:0; width: 2rem; height: 2rem; color: var(--brenson-certificado); margin-top: 0.08rem; }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Brenson · Certificación",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Auditoría previa a entrega" },
    { "type": "text", "id": "title", "label": "Título", "default": "Los 12 puntos de inspección antes de cada entrega" },
    { "type": "textarea", "id": "text", "label": "Texto (si el metaobject no tiene descripción)", "default": "Ningún vehículo se entrega en Colombia sin superar esta lista de validación mecánica y electrónica." },
    { "type": "text", "id": "seal_text", "label": "Texto del sello", "default": "Aprobado por el equipo técnico de ingeniería de Brenson S.A.S. para todo el país." },
    { "type": "paragraph", "content": "El checklist viene del metaobject Certificación. Desactivar el sello desde Ajustes → Brenson · Confianza hasta que el proceso esté operando." }
  ],
  "presets": [ { "name": "Brenson · Certificación" } ],
  "enabled_on": { "templates": ["product", "page", "index"] }
}
{% endschema %}
