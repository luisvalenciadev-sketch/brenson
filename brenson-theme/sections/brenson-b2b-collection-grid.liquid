{%- comment -%}
  brenson-b2b-collection-grid — Módulo 08. Catálogo corporativo con gating server-side (R-A2).
  Reemplaza a main-collection-product-grid en collection.empresas.json: si el cliente no está aprobado,
  NO se emiten productos ni precios; se muestra la invitación a solicitar acceso.
  Precio corporativo = precio público × (1 − descuento tier). Display only; la Function aplica el descuento real.
  La colección debe tener metafield brenson.solo_empresas = true (noindex en meta-tags).
{%- endcomment -%}
{%- include 'brenson-b2b-guard' -%}
<section class="brenson-section">
  <div class="brenson-container">
    {%- if b2b_state != 'aprobado' -%}
      <div class="brenson-b2b-card brenson-b2b-card--center">
        <span class="brenson-status brenson-status--muted">Catálogo corporativo</span>
        <h1 class="brenson-heading">Precios de flota disponibles para empresas aprobadas</h1>
        <p class="brenson-subheading">Inicie sesión con su cuenta corporativa o solicite acceso. Validamos su empresa en 24 horas hábiles.</p>
        <div style="display:flex; gap:1.2rem; flex-wrap:wrap; justify-content:center">
          <a class="brenson-btn brenson-btn--carbon" href="/pages/empresas#b2b-login">Iniciar sesión</a>
          <a class="brenson-btn brenson-btn--primary" href="/pages/empresas-acceso">Solicitar acceso</a>
        </div>
      </div>
    {%- else -%}
      <header style="display:flex; flex-wrap:wrap; align-items:center; gap: var(--brenson-space-3); margin-bottom: var(--brenson-space-6)">
        <h1 style="margin:0; font-size: clamp(2.56rem, 3vw, 3.6rem)">{{ collection.title }}</h1>
        {%- if b2b_tier -%}<span class="brenson-badge brenson-badge--rojo brenson-badge--sm">Tier {{ b2b_tier.nombre.value }} · {{ b2b_descuento | round }} %</span>{%- endif -%}
        <a class="brenson-btn brenson-btn--primary brenson-btn--sm" style="margin-left:auto" href="/pages/cotizador">Ir al cotizador</a>
        {%- if collection.description != blank -%}<p style="width:100%; margin:0; color: rgba(255,255,255,.7); font-size: var(--brenson-text-sm)">{{ collection.description | strip_html }}</p>{%- endif -%}
      </header>

      {%- paginate collection.products by 24 -%}
        <ul class="brenson-grid brenson-grid--3" role="list">
          {%- for p in collection.products -%}
            {%- assign pm = p.metafields.brenson -%}
            {%- assign row_disc = b2b_descuento -%}
            {%- if pm.b2b_precio_tier.value and b2b_tier and pm.b2b_precio_tier.value[b2b_tier.codigo.value] -%}{%- assign row_disc = pm.b2b_precio_tier.value[b2b_tier.codigo.value] -%}{%- endif -%}
            {%- assign factor = 100 | minus: row_disc | divided_by: 100.0 -%}
            {%- assign b2b_price = p.price_min | times: factor | round -%}
            <li class="brenson-b2b-card" style="padding:0; overflow:hidden">
              <div class="brenson-card__media">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 990px) 33vw, 100vw' }}{%- endif -%}
                <div class="brenson-card__badges">
                  {%- if pm.exclusivo_flota.value -%}<span class="brenson-badge brenson-badge--rojo brenson-badge--sm">Exclusivo flota</span>{%- endif -%}
                  {%- if pm.b2b_minimo_unidades.value -%}<span class="brenson-badge brenson-badge--carbon brenson-badge--sm">Mín. {{ pm.b2b_minimo_unidades.value }} u.</span>{%- endif -%}
                </div>
              </div>
              <div class="brenson-card__body">
                <h2 class="brenson-card__title"><a href="{{ p.url }}">{{ p.title }}</a></h2>
                <p class="brenson-muted" style="font-size: var(--brenson-text-sm); margin:0">{{ pm.autonomia_km.value }} km · {{ pm.velocidad_max_kmh.value }} km/h · {{ pm.capacidad_carga_kg.value }} kg</p>
                <div class="brenson-card__footer">
                  <div>
                    <span class="brenson-quoter__price-public brenson-num">{{ p.price_min | money_without_trailing_zeros }}</span><br>
                    <span class="brenson-quoter__price-b2b brenson-num" style="color: var(--brenson-rojo)">{{ b2b_price | money_without_trailing_zeros }}</span>
                    <span style="font-size: var(--brenson-text-xs); color: var(--brenson-certificado); font-weight:700"> · {{ row_disc | round }} % aplicado</span>
                  </div>
                  <a class="brenson-btn brenson-btn--outline brenson-btn--sm" href="/pages/cotizador?add={{ p.handle }}">Agregar a cotización</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}<div style="margin-top: var(--brenson-space-8)">{% render 'pagination', paginate: paginate %}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Empresas · Catálogo",
  "tag": "div",
  "settings": [ { "type": "paragraph", "content": "Catálogo corporativo con precios por tier. Solo renderiza productos para clientes aprobados." } ],
  "presets": [ { "name": "Empresas · Catálogo" } ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}