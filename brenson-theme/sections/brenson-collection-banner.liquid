{%- comment -%}
  brenson-collection-banner — Pantalla Stitch 02. Reemplaza main-collection-banner (Dawn).
  Sin imagen: la foto de colección no se ve bien recortada en la proporción del banner
  (decisión de la validación visual — se prefiere una tarjeta de texto completa y prolija).
{%- endcomment -%}
{%- liquid
  assign cheapest = nil
  for p in collection.products limit: 50
    if p.metafields.brenson.financiable.value != false
      if cheapest == nil or p.price_min < cheapest.price_min
        assign cheapest = p
      endif
    endif
  endfor
-%}
<section class="brenson-section brenson-collection-banner">
  <div class="brenson-container">
    <div class="brenson-collection-banner__card">
      <span class="brenson-collection-banner__eyebrow"><span class="brenson-collection-banner__dot"></span>{{ section.settings.eyebrow | default: '100 % movilidad eléctrica' }}</span>
      <h1 class="brenson-heading" style="margin: var(--brenson-space-3) 0 0">{{ collection.title }}</h1>
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="brenson-subheading rte">{{ collection.description }}</div>
      {%- endif -%}
      <div class="brenson-chips" style="margin-top: var(--brenson-space-5)">
        {%- if cheapest -%}
          <span class="brenson-badge brenson-badge--gris brenson-badge--md" style="gap:.4rem">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            {%- capture cuota -%}{%- render 'brenson-price', product: cheapest, layout: 'card' -%}{%- endcapture -%}
            Desde <strong>{{ cuota | split: 'data-brenson-cuota>' | last | split: '<' | first }}/mes</strong>
          </span>
        {%- endif -%}
        <span class="brenson-badge brenson-badge--verde brenson-badge--md" style="gap:.4rem">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ settings.brenson_garantia_texto }}
        </span>
        {%- if collection.products_count > 0 -%}
          <span class="brenson-badge brenson-badge--carbon brenson-badge--md" style="gap:.4rem">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ collection.products_count }} modelo{% if collection.products_count != 1 %}s{% endif %} disponible{% if collection.products_count != 1 %}s{% endif %}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
  .brenson-collection-banner { padding-bottom: 0; }
  .brenson-collection-banner__card { background: #fff; border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-xl); padding: var(--brenson-space-8); box-shadow: var(--brenson-shadow-sm); width: 100%; }
  .brenson-collection-banner__eyebrow { display:inline-flex; align-items:center; gap:0.56rem; background: var(--brenson-certificado-suave); color: var(--brenson-certificado); font-size: var(--brenson-text-xs); font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding: 0.4rem 1.12rem; border-radius: 999px; }
  .brenson-collection-banner__dot { width:0.64rem; height:0.64rem; border-radius:50%; background: currentColor; }
</style>

{% schema %}
{
  "name": "Colección · Banner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "100 % movilidad eléctrica" },
    { "type": "checkbox", "id": "show_collection_description", "label": "Mostrar descripción de la colección", "default": true }
  ],
  "presets": [ { "name": "Colección · Banner" } ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
