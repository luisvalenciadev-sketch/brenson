{%- comment -%}
  brenson-account-gate — Pantalla Stitch 05. Crear cuenta + Iniciar sesión en una sola pantalla.
  Se usa como sección "main" en customers/login.json y customers/register.json (ambas rutas
  muestran la misma pantalla combinada; Shopify enlaza los errores de cada form a la ruta que
  procesó el POST). Ciudad/uso previsto no son campos nativos del cliente: se guardan como JSON
  en customer[note] (mismo patrón ya usado en brenson-b2b-request-access.liquid).
{%- endcomment -%}
{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="brenson-section brenson-account-gate">
  <div class="brenson-container" style="max-width: 1100px">
    <header class="brenson-section__head brenson-section__head--center">
      <span class="brenson-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="brenson-heading">{{ section.settings.title }}</h1>
      <p class="brenson-subheading">{{ section.settings.subtitle }}</p>
    </header>

    <div class="brenson-account-gate__grid">
      {%- comment -%} Crear cuenta {%- endcomment -%}
      <div class="brenson-b2b-card">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap: var(--brenson-space-4); flex-wrap:wrap;">
          <div>
            <h2 style="margin:0 0 0.4rem; font-size: var(--brenson-text-xl)">Crear cuenta</h2>
            <p class="brenson-muted" style="font-size: var(--brenson-text-sm); margin:0; max-width: 32rem;">Regístrate para comprar tu vehículo eléctrico, gestionar tu garantía y acceder a financiación directa.</p>
          </div>
          <div class="brenson-tabs" role="tablist" style="width: 22rem; flex-shrink:0;" data-brenson-register-type>
            <button type="button" role="tab" class="brenson-tab" aria-selected="true" data-type="personal">Persona</button>
            <button type="button" role="tab" class="brenson-tab" aria-selected="false" data-type="empresa">Empresa <span class="brenson-badge brenson-badge--gris brenson-badge--sm">B2B</span></button>
          </div>
        </div>

        <div class="brenson-b2b-card" data-brenson-register-empresa hidden style="background: var(--brenson-gris-claro); box-shadow:none; margin-top: var(--brenson-space-4);">
          <strong>¿Compra para su empresa o requiere factura con NIT?</strong>
          <p class="brenson-muted" style="margin:0; font-size: var(--brenson-text-sm)">Cree su cuenta corporativa con NIT y acceda a precios por volumen, cotizador de flota y asesor dedicado.</p>
          <a class="brenson-btn brenson-btn--carbon brenson-btn--block" href="/pages/empresas-acceso">Registrar mi empresa en Brenson Empresas</a>
        </div>

        {%- form 'create_customer', novalidate: 'novalidate', class: 'brenson-form', style: 'margin-top: var(--brenson-space-5)' -%}
          {%- if form.errors -%}
            <p class="brenson-form__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="customer[note]" data-brenson-account-note value="">
          <div class="brenson-form__row brenson-form__row--2">
            <div class="brenson-field">
              <label for="RegisterForm-FirstName">Nombre *</label>
              <input type="text" name="customer[first_name]" id="RegisterForm-FirstName" value="{{ form.first_name }}" autocomplete="given-name" placeholder="Ej. Carlos" required>
            </div>
            <div class="brenson-field">
              <label for="RegisterForm-LastName">Apellido *</label>
              <input type="text" name="customer[last_name]" id="RegisterForm-LastName" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Ej. Rodríguez" required>
            </div>
          </div>
          <div class="brenson-field">
            <label for="RegisterForm-Email">Correo electrónico *</label>
            <input type="email" name="customer[email]" id="RegisterForm-Email" value="{{ form.email }}" autocomplete="email" placeholder="tu.correo@ejemplo.com" required>
          </div>
          <div class="brenson-field">
            <label for="RegisterForm-Password">Contraseña *</label>
            <div style="position:relative">
              <input type="password" name="customer[password]" id="RegisterForm-Password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" minlength="8" required style="padding-right: 4.4rem">
              <button type="button" class="brenson-field__toggle-pass" data-brenson-toggle-pass aria-label="Mostrar contraseña">Ver</button>
            </div>
            <p class="brenson-field__hint">Usa al menos 8 caracteres combinando números y letras.</p>
          </div>
          <div class="brenson-form__row brenson-form__row--2">
            <div class="brenson-field">
              <label for="RegisterForm-City">Ciudad de residencia *</label>
              <select id="RegisterForm-City" data-brenson-account-field="ciudad" required>
                <option value="">Seleccione</option>
                <option value="Bogotá D.C.">Bogotá D.C.</option>
                <option value="Medellín">Medellín</option>
                <option value="Barranquilla">Barranquilla</option>
                <option value="Cali">Cali</option>
                <option value="Cartagena">Cartagena</option>
                <option value="Bucaramanga">Bucaramanga</option>
                <option value="Otra">Otra ciudad</option>
              </select>
            </div>
            <div class="brenson-field">
              <label for="RegisterForm-Uso">Uso previsto del vehículo *</label>
              <select id="RegisterForm-Uso" data-brenson-account-field="uso" required>
                <option value="">Seleccione</option>
                <option value="Personal / Urbano">Personal / Urbano</option>
                <option value="Domicilios y mensajería">Domicilios y mensajería</option>
                <option value="Trabajo / Flota pequeña">Trabajo / Flota pequeña</option>
                <option value="Turismo o alquiler">Turismo o alquiler</option>
              </select>
            </div>
          </div>
          <div class="brenson-field">
            <label style="display:flex; gap:0.8rem; align-items:flex-start; font-weight:400; font-size: var(--brenson-text-xs)">
              <input type="checkbox" required style="width:auto; min-height:auto; margin-top:0.24rem">
              <span>Acepto la <a class="link" href="/policies/privacy-policy">política de tratamiento de datos</a> (Ley 1581 de 2012 y regulación colombiana).</span>
            </label>
          </div>
          <div class="brenson-field">
            <label style="display:flex; gap:0.8rem; align-items:flex-start; font-weight:400; font-size: var(--brenson-text-xs)">
              <input type="checkbox" name="customer[accepts_marketing]" value="1" checked style="width:auto; min-height:auto; margin-top:0.24rem">
              <span>Quiero recibir novedades, lanzamientos y ofertas exclusivas de cuotas bajas de Brenson.</span>
            </label>
          </div>
          <button type="submit" class="brenson-btn brenson-btn--primary brenson-btn--lg brenson-btn--block">Crear cuenta</button>
        {%- endform -%}

        <div class="brenson-account-gate__callout">
          <span class="brenson-account-gate__callout-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="4" width="18" height="16" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 9h8M8 13h8M8 17h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
          <div>
            <strong style="font-size: var(--brenson-text-sm)">¿Compras para tu empresa o requieres factura con NIT?</strong>
            <p class="brenson-muted" style="margin:0.24rem 0 0; font-size: var(--brenson-text-sm)">Accede a precios preferenciales por volumen (descuentos del 8 % al 18 %) y asesor corporativo asignado.</p>
          </div>
          <a class="brenson-btn brenson-btn--carbon brenson-btn--sm" style="flex-shrink:0" href="/pages/empresas-acceso">Brenson Empresas</a>
        </div>
      </div>

      {%- comment -%} Iniciar sesión {%- endcomment -%}
      <div class="brenson-b2b-card brenson-account-gate__login">
        <h2 style="margin:0 0 0.4rem; font-size: var(--brenson-text-xl); color:#fff;">Iniciar sesión</h2>
        <p class="brenson-muted" style="font-size: var(--brenson-text-sm); margin:0 0 var(--brenson-space-5); color: rgba(255,255,255,.7);">Ingresa a tu cuenta personal para ver tus compras, cuotas y garantías.</p>

        {%- form 'customer_login', novalidate: 'novalidate', class: 'brenson-form' -%}
          {%- if form.errors -%}
            <p class="brenson-form__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="brenson-field">
            <label for="CustomerEmail">Correo electrónico</label>
            <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" placeholder="tu.correo@ejemplo.com" required>
          </div>
          {%- if form.password_needed -%}
            <div class="brenson-field">
              <div style="display:flex; justify-content:space-between; align-items:baseline;">
                <label for="CustomerPassword" style="margin-bottom:0.32rem">Contraseña</label>
                <a class="link" style="font-size: var(--brenson-text-xs)" href="{{ routes.account_recover_url }}">¿Olvidaste tu contraseña?</a>
              </div>
              <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="········" required>
            </div>
          {%- endif -%}
          <button type="submit" class="brenson-btn brenson-btn--block" style="background:#fff; color: var(--brenson-carbon);">Ingresar →</button>
        {%- endform -%}

        <p class="brenson-account-gate__login-tag">Portal cliente seguro</p>
        <div class="brenson-account-gate__benefits">
          <p style="display:flex; align-items:center; gap:0.64rem; font-weight:700; margin:0 0 var(--brenson-space-3); color:#fff;">Todo lo que puedes hacer desde tu cuenta:</p>
          <ul class="brenson-checklist" style="grid-template-columns:1fr; color: rgba(255,255,255,.85);">
            <li>Seguimiento de pedidos y estado de despacho en tiempo real.</li>
            <li>Estado de garantía por unidad vinculada a tu número de chasis / serie.</li>
            <li>Facturación electrónica DIAN descargable en PDF y XML.</li>
            <li>Historial de cotizaciones y solicitudes de financiación previas con aliados.</li>
          </ul>
        </div>
        <p style="display:flex; justify-content:space-between; align-items:center; gap: var(--brenson-space-3); flex-wrap:wrap; margin: var(--brenson-space-5) 0 0; font-size: var(--brenson-text-xs); color: rgba(255,255,255,.6);">
          <span>¿Requieres asistencia directa?</span>
          <a class="link" style="color:#fff" href="{% render 'brenson-whatsapp-link', context: 'servicio' %}" target="_blank" rel="noopener">WhatsApp Soporte ↗</a>
        </p>
      </div>
    </div>
  </div>
</section>
<style>
  .brenson-account-gate__grid { display: grid; gap: var(--brenson-space-6); margin-top: var(--brenson-space-8); align-items: start; }
  @media (min-width: 990px) { .brenson-account-gate__grid { grid-template-columns: 1.15fr 1fr; } }
  .brenson-account-gate__login { background: var(--brenson-carbon); }
  .brenson-account-gate__login .brenson-field label { color: rgba(255,255,255,.85); }
  .brenson-account-gate__login .brenson-field input { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); color: #fff; }
  .brenson-account-gate__login-tag { text-transform: uppercase; letter-spacing: var(--brenson-tracking-wide); font-size: var(--brenson-text-xs); color: rgba(255,255,255,.5); text-align:center; margin: var(--brenson-space-6) 0 var(--brenson-space-4); padding-top: var(--brenson-space-5); border-top: 1px solid rgba(255,255,255,.1); }
  .brenson-account-gate__benefits { background: rgba(255,255,255,.05); border-radius: var(--brenson-radius-lg); padding: var(--brenson-space-5); }
  .brenson-field__toggle-pass { position:absolute; right:0.8rem; top:50%; transform:translateY(-50%); border:0; background:transparent; font-size: var(--brenson-text-xs); font-weight:700; color: var(--brenson-gris); cursor:pointer; }
  .brenson-account-gate__callout { display:flex; align-items:flex-start; gap: var(--brenson-space-4); margin-top: var(--brenson-space-6); padding-top: var(--brenson-space-5); border-top: 1px solid var(--brenson-gris-borde); flex-wrap:wrap; }
  .brenson-account-gate__callout-icon { flex-shrink:0; width:4rem; height:4rem; border-radius: var(--brenson-radius); background: var(--brenson-gris-claro); display:grid; place-items:center; color: var(--brenson-carbon); }
</style>
<script>
  (function(){
    var t=document.querySelector('[data-brenson-register-type]'),p=document.querySelector('[data-brenson-register-empresa]'),f=document.querySelector('.brenson-account-gate form[action*="account"]');
    if(t){t.addEventListener('click',function(e){var b=e.target.closest('[data-type]');if(!b)return;t.querySelectorAll('[data-type]').forEach(function(x){x.setAttribute('aria-selected',String(x===b))});var emp=b.dataset.type==='empresa';p.hidden=!emp;});}
    var toggle=document.querySelector('[data-brenson-toggle-pass]');
    if(toggle){toggle.addEventListener('click',function(){var inp=toggle.previousElementSibling;var show=inp.type==='password';inp.type=show?'text':'password';toggle.textContent=show?'Ocultar':'Ver';});}
    var noteInput=document.querySelector('[data-brenson-account-note]');
    var fields=document.querySelectorAll('[data-brenson-account-field]');
    if(noteInput&&fields.length){
      var sync=function(){var data={};fields.forEach(function(el){data[el.dataset.brensonAccountField]=el.value;});noteInput.value=JSON.stringify(data);};
      fields.forEach(function(el){el.addEventListener('change',sync);});
      sync();
    }
  })();
</script>

{% schema %}
{
  "name": "Cuenta · Acceso",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Acceso a clientes · Brenson Colombia" },
    { "type": "text", "id": "title", "label": "Título", "default": "Gestiona tu movilidad eléctrica" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Adquiere tu vehículo, haz seguimiento a tu despacho y accede al historial técnico de tus baterías." },
    { "type": "paragraph", "content": "Se usa como sección principal de las plantillas de inicio de sesión y creación de cuenta. Ciudad y uso previsto se guardan en la nota del cliente (no son campos nativos de Shopify)." }
  ],
  "presets": [ { "name": "Cuenta · Acceso" } ],
  "enabled_on": { "templates": ["customers/login", "customers/register"] }
}
{% endschema %}
