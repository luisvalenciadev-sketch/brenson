{%- comment -%}
  brenson-financing-compare — Pantalla Stitch 06. Tabla comparativa de cuota estimada por vehículo.
  Cuota calculada con el mismo sistema francés que brenson-simulator.js (P·i / (1−(1+i)^−n)),
  usando la tasa/plazo/inicial por defecto de brenson_parametros_financiacion (S3).
  Estado por fila: se deriva de señales reales (flota B2B, disponibilidad e inventario), no de datos inventados.
{%- endcomment -%}
{%- liquid
  assign params = shop.metaobjects.brenson_parametros_financiacion.values | first
  assign tasa = 1.9
  assign plazo_default = 36
  assign inicial_default = 10
  if params
    if params.tasa_mensual.value
      assign tasa = params.tasa_mensual.value
    endif
    if params.plazo_default.value
      assign plazo_default = params.plazo_default.value
    endif
    if params.inicial_default.value
      assign inicial_default = params.inicial_default.value
    endif
  endif
  assign i = tasa | divided_by: 100.0
  assign one_plus_i = i | plus: 1.0
  assign low_stock = section.settings.low_stock_threshold
-%}
<section class="brenson-section brenson-financing-compare">
  <div class="brenson-container">
    <header class="brenson-section__head" style="display:flex; justify-content:space-between; align-items:flex-end; gap: var(--brenson-space-4); flex-wrap:wrap;">
      <div>
        <span class="brenson-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="brenson-heading" style="margin-bottom:0">{{ section.settings.title }}</h2>
        <p class="brenson-subheading" style="margin-top:0.4rem">{{ section.settings.subtitle }} a {{ plazo_default }} meses · {{ inicial_default }} % de inicial.</p>
      </div>
    </header>

    <div class="brenson-table-wrap">
      <table class="brenson-table brenson-financing-compare__table">
        <thead>
          <tr><th>Vehículo y tipo</th><th>Precio contado</th><th>Cuota estimada</th><th style="text-align:center">Estado</th><th style="text-align:right">Acción</th></tr>
        </thead>
        <tbody>
          {%- for p in section.settings.collection.products limit: 12 -%}
            {%- liquid
              assign pm = p.metafields.brenson
              assign inicial_amt = p.price_min | times: inicial_default | divided_by: 100
              assign principal = p.price_min | minus: inicial_amt
              assign pow = 1.0
              for x in (1..plazo_default)
                assign pow = pow | times: one_plus_i
              endfor
              assign pow_minus_1 = pow | minus: 1.0
              assign cuota = 0
              if pow_minus_1 > 0
                assign cuota_raw = principal | times: i | times: pow | divided_by: pow_minus_1
                assign cuota = cuota_raw | divided_by: 100 | round | times: 100
              endif
              assign variant = p.selected_or_first_available_variant
              assign is_bestseller = false
              if pm.badge.value == 'mas_vendido'
                assign is_bestseller = true
              endif

              assign estado_label = 'Entrega inmediata'
              assign estado_mod = 'ok'
              if pm.exclusivo_flota.value
                assign estado_label = 'Portal Empresas B2B'
                assign estado_mod = 'muted'
              elsif p.available == false
                assign estado_label = 'Agotado'
                assign estado_mod = 'error'
              elsif variant.inventory_management != blank and variant.inventory_quantity <= low_stock
                assign estado_label = 'En bodega'
                assign estado_mod = 'pending'
              endif

              assign categoria = pm.categoria.value
            -%}
            <tr {% if is_bestseller %}class="brenson-financing-compare__row--featured"{% endif %}>
              <td>
                <div style="display:flex; align-items:center; gap: var(--brenson-space-3)">
                  <span class="brenson-financing-compare__icon" aria-hidden="true">
                    {%- case categoria -%}
                      {%- when 'bicicleta' -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M6 17 10 8h4l4 9M10 8l3 5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {%- when 'motocarro' -%}<svg viewBox="0 0 24 24"><rect x="3" y="10" width="8" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M11 13h4l3 3v2h-2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {%- when 'cuadriciclo' -%}<svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="7" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M6 17h5l3-8h4M11 17l3-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    {%- endcase -%}
                  </span>
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: p.title, style: 'width:4.8rem; height:4.8rem; object-fit:cover; border-radius: var(--brenson-radius); background: var(--brenson-gris-claro)' }}{%- endif -%}
                  <div>
                    <div style="display:flex; align-items:center; gap:0.56rem;">
                      <a class="link" style="font-weight:700; color: var(--brenson-carbon)" href="{{ p.url }}">{{ p.title }}</a>
                      {%- if pm.badge.value != blank -%}{% render 'brenson-badge', product: p, type: 'catalogo', size: 'sm' %}{%- endif -%}
                    </div>
                    {%- if pm.descripcion_corta.value -%}<p class="brenson-muted" style="margin:0.16rem 0 0; font-size: var(--brenson-text-xs)">{{ pm.descripcion_corta.value }}</p>{%- endif -%}
                  </div>
                </div>
              </td>
              <td class="brenson-num">{{ p.price_min | money_without_trailing_zeros }} <span class="brenson-muted" style="font-size:var(--brenson-text-xs); font-weight:400;">COP</span></td>
              <td class="brenson-num"><span class="brenson-muted" style="display:block; font-size: var(--brenson-text-xs); font-weight:400;">Desde</span><strong style="color: var(--brenson-rojo); font-size: {% if is_bestseller %}var(--brenson-text-lg){% else %}var(--brenson-text-md){% endif %};">{{ cuota | money_without_trailing_zeros }}</strong> <span class="brenson-muted" style="font-size: var(--brenson-text-xs)">/mes</span></td>
              <td style="text-align:center"><span class="brenson-status brenson-status--{{ estado_mod }}">{{ estado_label }}</span></td>
              <td style="text-align:right; white-space:nowrap">
                {%- if is_bestseller -%}
                  <a class="brenson-btn brenson-btn--carbon brenson-btn--sm" href="#brenson-simulator" data-sim-select-price="{{ p.price_min }}" data-sim-select-title="{{ p.title | escape }}">Simular este →</a>
                {%- else -%}
                  <a class="brenson-btn brenson-btn--outline brenson-btn--sm" href="{{ p.url }}">Ver vehículo →</a>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p class="brenson-muted" style="font-size: var(--brenson-text-xs); margin-top: var(--brenson-space-3)">* Cuota estimada a {{ plazo_default }} meses con {{ inicial_default }} % de inicial y la tasa referencial vigente ({{ tasa }} % mensual). Sujeta a estudio y aprobación crediticia.</p>
  </div>
</section>
<style>
  .brenson-financing-compare__icon { flex-shrink:0; width:3.2rem; height:3.2rem; border-radius:50%; background: var(--brenson-gris-claro); color: var(--brenson-carbon-60); display:none; align-items:center; justify-content:center; }
  .brenson-financing-compare__icon svg { width:1.8rem; height:1.8rem; }
  @media (min-width: 750px) { .brenson-financing-compare__icon { display:flex; } }
  .brenson-financing-compare__row--featured { background: var(--brenson-rojo-suave); }
  .brenson-financing-compare .brenson-table th { padding: var(--brenson-space-4) var(--brenson-space-5); font-size: var(--brenson-text-xs); }
  .brenson-financing-compare .brenson-table td { padding: var(--brenson-space-5); }
  .brenson-financing-compare .brenson-table-wrap { border: 1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-lg); overflow: hidden; }
  .brenson-financing-compare .brenson-table thead { background: var(--brenson-gris-claro); }
  .brenson-financing-compare .brenson-table tbody tr:hover { background: var(--brenson-gris-claro); }
  .brenson-financing-compare .brenson-table tbody tr.brenson-financing-compare__row--featured:hover { background: var(--brenson-rojo-suave); }
  .brenson-financing-compare .brenson-table tbody tr:last-child td { border-bottom: 0; }
</style>
<script>
  (function(){
    document.querySelectorAll('[data-sim-select-price]').forEach(function(link){
      link.addEventListener('click', function(e){
        var sim = document.querySelector('#brenson-simulator brenson-simulator');
        var priceInput = document.getElementById('sim-precio');
        var select = document.getElementById('sim-vehiculo');
        if (sim && priceInput) {
          e.preventDefault();
          if (select) select.value = '';
          priceInput.value = new Intl.NumberFormat('es-CO').format(parseInt(link.dataset.simSelectPrice, 10));
          priceInput.dispatchEvent(new Event('input', { bubbles: true }));
          document.getElementById('brenson-simulator').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Financiación · Cuotas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Portafolio disponible" },
    { "type": "text", "id": "title", "label": "Título", "default": "Compara la cuota por vehículo" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Modelos homologados con respaldo oficial y entrega nacional. Calculado" },
    { "type": "collection", "id": "collection", "label": "Colección de vehículos" },
    { "type": "range", "id": "low_stock_threshold", "min": 0, "max": 20, "step": 1, "label": "Umbral de \"En bodega\" (unidades en inventario)", "default": 5 }
  ],
  "presets": [ { "name": "Financiación · Cuotas" } ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
