{{ 'brenson-article.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  brenson-article-related — Artículos relacionados al pie de un artículo.
  Prioriza los del mismo tag/categoría; si no completan el cupo, rellena con los más recientes
  del blog. Siempre excluye el artículo actual.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit | default: 3

  assign category = ''
  for t in article.tags
    unless t == 'mock'
      assign category = t
      break
    endunless
  endfor

  assign picked = ''
  assign count = 0

  for a in blog.articles
    if count >= limit
      break
    endif
    if a.id == article.id
      continue
    endif
    if category != blank and a.tags contains category
      assign picked = picked | append: a.id | append: ','
      assign count = count | plus: 1
    endif
  endfor

  for a in blog.articles
    if count >= limit
      break
    endif
    if a.id == article.id
      continue
    endif
    assign needle = a.id | append: ','
    unless picked contains needle
      assign picked = picked | append: needle
      assign count = count | plus: 1
    endunless
  endfor
-%}

{%- if count > 0 -%}
  <section class="brenson-article__related">
    <div class="brenson-container">
      <div class="brenson-article__related-head">
        <span class="brenson-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.title }}</h2>
      </div>

      <ul class="brenson-related-grid" role="list">
        {%- assign picked_ids = picked | split: ',' -%}
        {%- for id in picked_ids -%}
          {%- for a in blog.articles -%}
            {%- assign a_id = a.id | append: '' -%}
            {%- if a_id == id -%}
              {%- liquid
                assign a_cat = ''
                for t in a.tags
                  unless t == 'mock'
                    assign a_cat = t
                    break
                  endunless
                endfor
              -%}
              <li class="brenson-related-card">
                <a class="brenson-related-card__media" href="{{ a.url }}">
                  {%- if a.image -%}
                    {{ a.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: a.title }}
                  {%- endif -%}
                  {%- if a_cat != blank -%}<span class="brenson-related-card__badge">{{ a_cat }}</span>{%- endif -%}
                </a>
                <div class="brenson-related-card__body">
                  <p class="brenson-related-card__meta">{{ a.published_at | date: '%d %b %Y' }}</p>
                  <h3><a href="{{ a.url }}">{{ a.title }}</a></h3>
                  <p class="brenson-related-card__excerpt">{{ a.excerpt_or_content | strip_html | truncate: 120 }}</p>
                </div>
              </li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

<style>
  .brenson-related-grid { display:grid; gap: var(--brenson-space-6); list-style:none; margin:0; padding:0; }
  @media (min-width: 750px) { .brenson-related-grid { grid-template-columns: repeat(3, 1fr); } }
  .brenson-related-card { display:flex; flex-direction:column; background:#fff; border:1px solid var(--brenson-gris-borde); border-radius: var(--brenson-radius-lg); overflow:hidden; }
  .brenson-related-card__media { position:relative; display:block; aspect-ratio:16/9; background: var(--brenson-gris-borde); }
  .brenson-related-card__media img { width:100%; height:100%; object-fit:cover; display:block; }
  .brenson-related-card__badge { position:absolute; top: var(--brenson-space-3); left: var(--brenson-space-3); background: rgba(255,255,255,.95); color: var(--brenson-carbon); font-size: var(--brenson-text-xs); font-weight:800; text-transform:uppercase; padding:0.16rem 0.8rem; border-radius: var(--brenson-radius); }
  .brenson-related-card__body { padding: var(--brenson-space-5); display:flex; flex-direction:column; gap:0.5rem; }
  .brenson-related-card__meta { margin:0; font-size: var(--brenson-text-xs); font-weight:600; color: var(--brenson-gris); }
  .brenson-related-card h3 { margin:0; font-size: var(--brenson-text-lg); line-height:1.3; }
  .brenson-related-card h3 a { color: var(--brenson-carbon); text-decoration:none; }
  .brenson-related-card h3 a:hover { color: var(--brenson-rojo); }
  .brenson-related-card__excerpt { margin:0; font-size: var(--brenson-text-sm); color: var(--brenson-carbon-60); }
</style>

{% schema %}
{
  "name": "Artículo · Relacionados",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Sigue leyendo" },
    { "type": "text", "id": "title", "label": "Título", "default": "Artículos relacionados" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Cantidad", "default": 3 }
  ],
  "presets": [ { "name": "Artículo · Relacionados" } ],
  "enabled_on": { "templates": ["article"] }
}
{% endschema %}
