{%- comment -%}
  brenson-b2b-contacto — Cierre de las pantallas Stitch 15 y 16:
  "Dedicated Corporate B2B Contact / Assessment CTA" + "Account Director Bio Card"
  + "Fast Executive Contact Form" (máximo 5 campos, según el design system).

  Se usa al final de /pages/empresas-beneficios y /pages/empresas-proceso.
  Envía al mismo endpoint de leads que el resto del sitio (data-brenson-lead-form),
  con respaldo al formulario de contacto nativo de Shopify si no hay JS.

  Visibilidad: contenido comercial. Se oculta a empresas ya aprobadas.
  theme-check-disable ConvertIncludeToRender
{%- endcomment -%}
{%- include 'brenson-b2b-guard' -%}
{%- if b2b_state != 'aprobado' -%}
{%- liquid
  assign s = section.settings
  assign asesor = b2b_asesor
  if asesor == blank
    for a in shop.metaobjects.brenson_asesor.values
      if a.canal.value == 'b2b'
        assign asesor = a
        break
      endif
    endfor
  endif
  assign rangos = s.rangos | split: ','
-%}

<section id="contacto" class="brenson-section brenson-b2b-contacto brenson-b2b-contacto--{{ s.variante }}{% if s.banda %} brenson-b2b-banda{% endif %}">
  <div class="brenson-container">

  {%- comment -%}
    Variante «asesor» (pantalla 16): una sola tarjeta, retrato centrado a la
    izquierda y llamada a la acción a la derecha. Sin formulario.
  {%- endcomment -%}
  {%- if s.variante == 'asesor' -%}
    <div class="brenson-b2b-card brenson-b2b-contacto__panel">
      <div class="brenson-b2b-contacto__retrato">
        <div class="brenson-b2b-contacto__foto brenson-b2b-contacto__foto--grande">
          {%- if asesor.foto.value -%}
            {{ asesor.foto.value | image_url: width: 384 | image_tag: loading: 'lazy', alt: asesor.nombre.value }}
          {%- else -%}
            <span aria-hidden="true">{{ asesor.nombre.value | default: 'B' | slice: 0 }}</span>
          {%- endif -%}
          <span class="brenson-b2b-contacto__punto" aria-hidden="true"></span>
        </div>
        {%- if asesor -%}
          <h3 class="brenson-b2b-contacto__nombre">{{ asesor.nombre.value }}</h3>
          {%- if asesor.cargo.value != blank -%}
            <p class="brenson-b2b-contacto__cargo">{{ asesor.cargo.value }}</p>
          {%- endif -%}
          {%- if s.especialidad != blank -%}
            <p class="brenson-muted" style="font-size: 1.1rem; margin:0">{{ s.especialidad }}</p>
          {%- endif -%}
        {%- endif -%}
        <span class="brenson-b2b-contacto__disponible">
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ s.respuesta }}
        </span>
      </div>

      <div class="brenson-b2b-contacto__llamada">
        <span class="brenson-eyebrow">Atención consultiva personalizada</span>
        <h2 class="brenson-heading" style="font-size: var(--brenson-text-2xl)">{{ s.title }}</h2>
        <p class="brenson-subheading">{{ s.text }}</p>
        <div class="brenson-b2b-contacto__botones">
          <a class="brenson-btn brenson-btn--primary" href="/pages/empresas-acceso">Agendar sesión técnica de flotas</a>
          <a class="brenson-btn brenson-btn--whatsapp-suave" href="{% render 'brenson-whatsapp-link', context: 'empresas' %}" target="_blank" rel="noopener">Hablar por WhatsApp corporativo</a>
        </div>
        <div class="brenson-b2b-contacto__datos">
          {%- if asesor.email.value != blank or settings.brenson_email_empresas != blank -%}
            {%- assign correo = asesor.email.value | default: settings.brenson_email_empresas -%}
            <a href="mailto:{{ correo }}">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m3.5 7 8.5 6 8.5-6" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
              {{ correo }}
            </a>
          {%- endif -%}
          {%- if asesor.whatsapp.value != blank -%}
            <a href="tel:{{ asesor.whatsapp.value | replace: ' ', '' }}">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
              {{ asesor.whatsapp.value }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

  {%- else -%}
    <div class="brenson-b2b-contacto__grid">

      {%- comment -%}
        Columna izquierda (5/12): tarjeta del asesor como pieza independiente y,
        debajo, el titular sobre la banda —sin tarjeta—, como en el diseño.
      {%- endcomment -%}
      <div class="brenson-b2b-contacto__col">
        {%- if asesor -%}
          <div class="brenson-b2b-card brenson-b2b-contacto__asesor">
            <div class="brenson-b2b-contacto__foto">
              {%- if asesor.foto.value -%}
                {{ asesor.foto.value | image_url: width: 224 | image_tag: loading: 'lazy', alt: asesor.nombre.value }}
              {%- else -%}
                <span aria-hidden="true">{{ asesor.nombre.value | slice: 0 }}</span>
              {%- endif -%}
              <span class="brenson-b2b-contacto__punto" aria-hidden="true"></span>
            </div>
            <div>
              <span class="brenson-eyebrow">Asesoría senior B2B</span>
              <strong class="brenson-b2b-contacto__nombre">{{ asesor.nombre.value }}</strong>
              {%- if asesor.cargo.value != blank -%}
                <p class="brenson-muted" style="font-size: var(--brenson-text-xs); margin:0">{{ asesor.cargo.value }}</p>
              {%- endif -%}
              <span class="brenson-b2b-contacto__disponible">
                <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ s.disponible }}
              </span>
            </div>
          </div>
        {%- endif -%}

        <div class="brenson-b2b-contacto__pitch">
          <h2 class="brenson-heading" style="font-size: var(--brenson-text-2xl)">{{ s.title }}</h2>
          <p class="brenson-subheading">{{ s.text }}</p>
          <a class="brenson-btn brenson-btn--whatsapp" href="{% render 'brenson-whatsapp-link', context: 'empresas' %}" target="_blank" rel="noopener">Hablar directamente por WhatsApp</a>
        </div>
      </div>

      {%- comment -%} ── Formulario ejecutivo (5 campos), columna 7/12 ── {%- endcomment -%}
      <div class="brenson-b2b-card brenson-b2b-contacto__formulario">
        <div class="brenson-b2b-contacto__form-head">
          <h3 style="margin:0; font-size: var(--brenson-text-lg)">{{ s.form_title }}</h3>
          <p class="brenson-muted" style="font-size: var(--brenson-text-xs); margin:0">{{ s.form_text }}</p>
        </div>

        {%- form 'contact', id: 'BrensonB2BContacto', class: 'brenson-form', data-brenson-lead-form: '', data-endpoint: settings.brenson_services_url -%}
          {%- if form.posted_successfully? -%}
            <p class="brenson-form__success" role="status">Recibimos su solicitud. Un ejecutivo la contactará en horario hábil.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="brenson-form__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[tipo]" data-name="tipo" value="b2b">
          <input type="hidden" name="contact[fuente]" data-name="fuente" value="empresas-contacto">
          <input type="hidden" name="contact[url]" data-name="url" value="{{ request.origin }}{{ request.path }}">
          <input type="text" name="contact[website]" tabindex="-1" autocomplete="off" class="brenson-visually-hidden" aria-hidden="true">

          <div class="brenson-b2b-contacto__fila">
            <div class="brenson-field">
              <label for="b2bc-empresa">Nombre de la empresa o razón social</label>
              <input id="b2bc-empresa" type="text" name="contact[empresa]" data-name="empresa" required placeholder="Ej. Logística Nacional S.A.S." autocomplete="organization">
            </div>
            <div class="brenson-field">
              <label for="b2bc-nit">NIT de la empresa</label>
              <input id="b2bc-nit" type="text" name="contact[nit]" data-name="nit" required placeholder="900.000.000-1" inputmode="numeric">
            </div>
          </div>
          <div class="brenson-b2b-contacto__fila">
            <div class="brenson-field">
              <label for="b2bc-nombre">Nombre y cargo del solicitante</label>
              <input id="b2bc-nombre" type="text" name="contact[name]" data-name="nombre" required placeholder="Ej. Juan Pérez · Director financiero" autocomplete="name">
            </div>
            <div class="brenson-field">
              <label for="b2bc-tel">Celular o WhatsApp corporativo</label>
              <input id="b2bc-tel" type="tel" name="contact[phone]" data-name="whatsapp" required placeholder="310 000 0000" inputmode="tel" autocomplete="tel">
            </div>
          </div>
          <div class="brenson-field">
            <label for="b2bc-rango">Rango de unidades requeridas</label>
            <select id="b2bc-rango" name="contact[rango_unidades]" data-name="rango_unidades" required>
              <option value="" disabled selected>Seleccione el rango</option>
              {%- for r in rangos -%}
                <option value="{{ r | strip | escape }}">{{ r | strip }}</option>
              {%- endfor -%}
            </select>
          </div>

          <div data-turnstile-slot></div>

          <button type="submit" class="brenson-btn brenson-btn--primary brenson-btn--lg brenson-btn--block" data-lead-submit>{{ s.form_cta }}</button>
          <p class="brenson-form__success" data-lead-success hidden role="status">Recibimos su solicitud. Un ejecutivo la contactará en horario hábil.</p>
          <p class="brenson-form__error" data-lead-error hidden role="alert">No pudimos enviar su solicitud. Escríbanos por WhatsApp o intente de nuevo.</p>
        {%- endform -%}
      </div>

    </div>
  {%- endif -%}
  </div>
</section>
{%- if s.variante != 'asesor' -%}
  <script src="{{ 'brenson-lead-form.js' | asset_url }}" defer></script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Empresas · Contacto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Hablemos de los números de su operación" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Analizamos sin costo la ruta, el peso de carga y los requerimientos de recarga de su compañía para entregarle una corrida financiera formal con TCO proyectado a 36 meses." },
    { "type": "text", "id": "form_title", "label": "Título del formulario", "default": "Solicitar diagnóstico y simulación de flota" },
    { "type": "textarea", "id": "form_text", "label": "Texto del formulario", "default": "Respuesta técnica y comercial en menos de 2 horas hábiles." },
    { "type": "text", "id": "form_cta", "label": "Texto del botón", "default": "Agendar sesión técnica con un especialista" },
    { "type": "text", "id": "rangos", "label": "Rangos de unidades (separados por coma)", "default": "10 a 19 unidades, 20 a 49 unidades, 50 o más unidades" },
    { "type": "text", "id": "disponible", "label": "Etiqueta de disponibilidad", "default": "Disponible hoy" },
    { "type": "checkbox", "id": "banda", "label": "Fondo en banda diferenciada", "default": true },

    { "type": "header", "content": "Variante de cierre" },
    {
      "type": "select", "id": "variante", "label": "Diseño del cierre", "default": "formulario",
      "options": [
        { "value": "formulario", "label": "Asesor + formulario ejecutivo" },
        { "value": "asesor", "label": "Solo asesor, con retrato grande" }
      ]
    },
    { "type": "text", "id": "especialidad", "label": "Especialidad del asesor", "default": "Especialista en ciclo-logística y homologación" },
    { "type": "text", "id": "respuesta", "label": "Tiempo de respuesta", "default": "Tiempo de respuesta: menos de 2 horas" }
  ],
  "presets": [{ "name": "Empresas · Contacto" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
