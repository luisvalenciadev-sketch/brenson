{%- comment -%}
  brenson-b2b-dashboard — Módulo 08. Dashboard del cliente corporativo aprobado (pantalla Stitch 04, decisión I3).
  Solo se renderiza con b2b_state == 'aprobado'. Datos:
    - Tier / asesor: metafields del cliente (brenson_b2b.*)
    - Cotizaciones: metaobject brenson_cotizacion_b2b filtrado por cliente (S15)
    - Unidades: metaobject brenson_unidad filtrado por cliente (S14)
  Nota: Liquid no puede filtrar metaobjects por referencia server-side de forma nativa; se recorren y se
  comparan por customer.id. Con <100 entradas es aceptable. Al escalar, brenson-services expone /me/quotes y /me/units.

  Layout mobile-first (brenson-empresas.css, bloque "Dashboard"):
    móvil   → bienvenida + CTA, KPIs 2×2, cotizaciones, asesor, unidades, documentos (una columna)
    tablet  → listas en dos columnas de tarjetas
    desktop → asesor | acciones+documentos arriba; cotizaciones y unidades a todo el ancho como filas
{%- endcomment -%}
{%- include 'brenson-b2b-guard' -%}
{%- if b2b_state == 'aprobado' -%}
{%- liquid
  assign tiers = shop.metaobjects.brenson_tier_b2b.values
  assign cid = customer.id | append: ''

  assign my_quotes = ''
  assign quotes_activas = 0
  for q in shop.metaobjects.brenson_cotizacion_b2b.values
    assign qcid = q.cliente_id.value | default: q.cliente.value.id | append: ''
    if qcid == cid
      assign my_quotes = my_quotes | append: q.system.handle | append: ','
      if q.estado.value == 'enviada' or q.estado.value == 'borrador'
        assign quotes_activas = quotes_activas | plus: 1
      endif
    endif
  endfor
  assign my_quote_handles = my_quotes | split: ','

  assign units_total = 0
  assign units_activas = 0
  assign units_reclamo = 0
  for u in shop.metaobjects.brenson_unidad.values
    assign ucid = u.cliente_id.value | default: u.cliente.value.id | append: ''
    if ucid == cid
      assign units_total = units_total | plus: 1
      if u.estado.value == 'activa'
        assign units_activas = units_activas | plus: 1
      elsif u.estado.value == 'en_reclamo'
        assign units_reclamo = units_reclamo | plus: 1
      endif
    endif
  endfor

  assign next_tier = nil
  for t in tiers
    if t.descuento_pct.value > b2b_descuento
      assign next_tier = t
      break
    endif
  endfor

  assign current_idx = -1
  for t in tiers
    if b2b_tier and t.system.handle == b2b_tier.system.handle
      assign current_idx = forloop.index0
    endif
  endfor
-%}
<section class="brenson-section brenson-b2b-dashboard">
  <div class="brenson-container">

    <div class="brenson-b2b-welcome">
      <div class="brenson-b2b-welcome__intro">
        <p class="brenson-b2b-welcome__company">{{ b2b_empresa }}{%- if customer.metafields.brenson_b2b.nit.value -%} · NIT {{ customer.metafields.brenson_b2b.nit.value }}{%- endif -%}</p>
        <h1>Bienvenido{% if customer.first_name %}, {{ customer.first_name }}{% endif %}</h1>
        <div class="brenson-b2b-welcome__badges">
          <span class="brenson-status brenson-status--ok">Cuenta aprobada</span>
          {%- if b2b_tier -%}<span class="brenson-badge brenson-badge--sm" style="background: rgba(255,255,255,.12); color:#fff">Tier {{ b2b_tier.nombre.value }} · {{ b2b_descuento | round }} % de descuento</span>{%- endif -%}
        </div>
      </div>
      <div class="brenson-b2b-welcome__actions">
        <a class="brenson-btn brenson-btn--primary" href="/pages/cotizador">Cotizar nueva flota</a>
        <a class="brenson-btn brenson-btn--outline" style="color:#fff; border-color: rgba(255,255,255,.4)" href="{{ routes.account_url }}">Configuración corporativa</a>
      </div>
    </div>

    <ul class="brenson-b2b-kpis" role="list">
      <li class="brenson-b2b-card"><span class="brenson-kpi__label">Descuento vigente</span><span class="brenson-kpi__value brenson-num">{{ b2b_descuento | round }} %</span>{%- if next_tier -%}<span class="brenson-kpi__note">Próximo tier: {{ next_tier.descuento_pct.value | round }} % desde {{ next_tier.minimo_unidades.value }} unidades</span>{%- else -%}<span class="brenson-kpi__note">Tier máximo alcanzado</span>{%- endif -%}</li>
      <li class="brenson-b2b-card"><span class="brenson-kpi__label">Unidades en operación</span><span class="brenson-kpi__value brenson-num">{{ units_total }}</span><span class="brenson-kpi__note">Registradas con número de serie</span></li>
      <li class="brenson-b2b-card"><span class="brenson-kpi__label">Cotizaciones activas</span><span class="brenson-kpi__value brenson-num">{{ quotes_activas }}</span><span class="brenson-kpi__note">Validez {{ settings.brenson_b2b_validez_dias | default: 15 }} días</span></li>
      <li class="brenson-b2b-card"><span class="brenson-kpi__label">Garantías activas</span><span class="brenson-kpi__value brenson-num">{{ units_activas }}</span>{%- if units_reclamo > 0 -%}<span class="brenson-kpi__note" style="color:#92400e">{{ units_reclamo }} en reclamo</span>{%- else -%}<span class="brenson-kpi__note">Sin reclamos abiertos</span>{%- endif -%}</li>
    </ul>

    <div class="brenson-b2b-dash">
      {%- comment -%} Cotizaciones {%- endcomment -%}
      <div class="brenson-b2b-card brenson-b2b-dash__quotes" id="cotizaciones" data-endpoint="{{ settings.brenson_services_url }}" data-customer-id="{{ customer.id }}">
        <div class="brenson-b2b-card__head">
          <h2>Mis cotizaciones</h2>
          <a class="brenson-btn brenson-btn--primary brenson-btn--sm" href="/pages/cotizador">Nueva cotización</a>
        </div>
        {%- if my_quote_handles.size > 0 and my_quote_handles.first != blank -%}
          {%- render 'brenson-b2b-quote-list', cid: cid, show_accept: true -%}
        {%- else -%}
          <p class="brenson-muted">Aún no tiene cotizaciones. Genere la primera en menos de dos minutos.</p>
        {%- endif -%}
      </div>

      {%- comment -%} Asesor {%- endcomment -%}
      <div class="brenson-b2b-card brenson-b2b-dash__advisor">
        <span class="brenson-kpi__label">Acompañamiento corporativo</span>
        <h2>Su asesor dedicado</h2>
        {%- if b2b_asesor -%}
          <div class="brenson-advisor">
            {%- if b2b_asesor.foto.value -%}{{ b2b_asesor.foto.value | image_url: width: 128 | image_tag: class: 'brenson-advisor__avatar', alt: b2b_asesor.nombre.value }}{%- else -%}<span class="brenson-advisor__avatar" aria-hidden="true">{{ b2b_asesor.nombre.value | slice: 0 }}</span>{%- endif -%}
            <div class="brenson-advisor__who">
              <strong>{{ b2b_asesor.nombre.value }}</strong>
              <span class="brenson-muted">{{ b2b_asesor.cargo.value }}{% if b2b_asesor.horario.value %} · {{ b2b_asesor.horario.value }}{% endif %}</span>
            </div>
            <div class="brenson-advisor__actions">
              <a class="brenson-btn brenson-btn--whatsapp brenson-btn--sm" href="https://wa.me/{{ b2b_asesor.whatsapp.value }}?text={{ 'Buen día, le escribo desde el portal Brenson Empresas.' | url_encode }}" target="_blank" rel="noopener" data-brenson-track="whatsapp_click" data-brenson-source="b2b_advisor">WhatsApp</a>
              {%- if b2b_asesor.email.value -%}<a class="brenson-btn brenson-btn--outline brenson-btn--sm" href="mailto:{{ b2b_asesor.email.value }}">Correo</a>{%- endif -%}
            </div>
          </div>
        {%- else -%}
          <p class="brenson-muted">Le asignaremos un asesor en las próximas horas. Mientras tanto escríbanos a <a class="link" href="mailto:{{ settings.brenson_email_empresas }}">{{ settings.brenson_email_empresas }}</a>.</p>
        {%- endif -%}
      </div>

      {%- comment -%} Acciones rápidas + documentos {%- endcomment -%}
      <div class="brenson-b2b-dash__side">
        <div class="brenson-b2b-card brenson-b2b-dash__actions">
          <span class="brenson-kpi__label">Acciones rápidas</span>
          <div class="brenson-quick-actions">
            <a class="brenson-btn brenson-btn--primary" href="/pages/cotizador">Nueva cotización de flota</a>
            {%- if settings.brenson_b2b_collection != blank -%}<a class="brenson-btn brenson-btn--outline" href="{{ settings.brenson_b2b_collection.url }}">Ver catálogo corporativo</a>{%- endif -%}
            <a class="brenson-btn brenson-btn--outline" href="{{ routes.account_url }}">Ver pedidos</a>
          </div>
        </div>
        <div class="brenson-b2b-card brenson-b2b-dash__docs">
          <span class="brenson-kpi__label">Fichas y documentos</span>
          <ul class="brenson-doc-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'documento' and block.settings.file != blank -%}
                <li {{ block.shopify_attributes }}><a href="{{ block.settings.file }}" target="_blank" rel="noopener"><span>{{ block.settings.title }}</span><span class="brenson-muted">PDF</span></a></li>
              {%- endif -%}
            {%- endfor -%}
            {%- if settings.brenson_services_url != blank -%}
              <li><a href="{{ settings.brenson_services_url }}/catalogo-flota.pdf" target="_blank" rel="noopener"><span>Catálogo de flota {{ 'now' | date: '%Y' }}</span><span class="brenson-muted">PDF</span></a></li>
            {%- endif -%}
          </ul>
          {%- if section.blocks.size == 0 -%}<p class="brenson-muted" style="font-size: var(--brenson-text-sm)">Agregue documentos desde el editor del tema.</p>{%- endif -%}
        </div>
      </div>

      {%- comment -%} Unidades {%- endcomment -%}
      <div class="brenson-b2b-card brenson-b2b-dash__units" id="unidades">
        <div class="brenson-b2b-card__head">
          <div>
            <h2>Mis unidades en flota</h2>
            <p class="brenson-muted">Control de serie, vigencia de garantía y estado operativo.</p>
          </div>
          <a class="brenson-btn brenson-btn--outline brenson-btn--sm" href="{% render 'brenson-whatsapp-link', context: 'garantias' %}" target="_blank" rel="noopener">Reportar garantía</a>
        </div>
        {%- if units_total > 0 -%}
          <ul class="brenson-b2b-list brenson-b2b-list--units" role="list">
            <li class="brenson-b2b-list__head" aria-hidden="true"><span>Serie / chasis</span><span>Vehículo</span><span>Pedido</span><span>Entrega</span><span>Garantía vehículo</span><span>Garantía batería</span><span>Estado</span></li>
            {%- for u in shop.metaobjects.brenson_unidad.values -%}
              {%- assign ucid = u.cliente_id.value | default: u.cliente.value.id | append: '' -%}
              {%- if ucid != cid -%}{%- continue -%}{%- endif -%}
              <li class="brenson-b2b-item">
                <div class="brenson-b2b-item__title"><code>{{ u.serie.value }}</code></div>
                <div class="brenson-b2b-item__field brenson-b2b-item__field--strong"><span class="brenson-b2b-item__label">Vehículo</span><span>{%- if u.producto.value -%}<a class="link" href="{{ u.producto.value.url }}">{{ u.producto.value.title }}</a>{%- endif -%}</span></div>
                <div class="brenson-b2b-item__field"><span class="brenson-b2b-item__label">Pedido</span><span>{{ u.pedido.value }}</span></div>
                <div class="brenson-b2b-item__field"><span class="brenson-b2b-item__label">Entrega</span><span>{{ u.fecha_entrega.value | date: '%d %b %Y' }}</span></div>
                <div class="brenson-b2b-item__field"><span class="brenson-b2b-item__label">Garantía vehículo</span><span>{% if u.fin_garantia.value %}hasta {{ u.fin_garantia.value | date: '%d %b %Y' }}{% endif %}</span></div>
                <div class="brenson-b2b-item__field"><span class="brenson-b2b-item__label">Garantía batería</span><span>{% if u.fin_garantia_bateria.value %}hasta {{ u.fin_garantia_bateria.value | date: '%d %b %Y' }}{% endif %}</span></div>
                <div class="brenson-b2b-item__status">{%- case u.estado.value -%}{%- when 'activa' -%}<span class="brenson-status brenson-status--ok">Activa</span>{%- when 'en_reclamo' -%}<span class="brenson-status brenson-status--pending">En reclamo</span>{%- else -%}<span class="brenson-status brenson-status--muted">Vencida</span>{%- endcase -%}</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="brenson-muted">Cuando reciba sus vehículos, cada unidad aparecerá aquí con su número de serie y garantía.</p>
        {%- endif -%}
      </div>
    </div>

    {%- if tiers.size > 0 -%}
      <div class="brenson-b2b-block">
        <header class="brenson-section__head brenson-section__head--center">
          <span class="brenson-eyebrow" style="color:#ff6b6b">Programa escala flotas Brenson</span>
          <h2 class="brenson-heading">Beneficios corporativos por volumen de flota</h2>
          <p class="brenson-subheading" style="color: rgba(255,255,255,.75)">Tarifas preferenciales, soporte técnico prioritario y condiciones de crédito flexibles estructuradas para su crecimiento logístico.</p>
        </header>
        <ul class="brenson-grid brenson-grid--3 brenson-carousel-mobile brenson-b2b-tiers" role="list">
          {%- for t in tiers -%}
            {%- assign is_current = false -%}
            {%- if forloop.index0 == current_idx -%}{%- assign is_current = true -%}{%- endif -%}
            <li class="brenson-b2b-card brenson-tier {% if is_current %}brenson-tier--featured{% endif %}">
              {%- if is_current -%}<span class="brenson-badge brenson-badge--rojo brenson-badge--sm brenson-tier__tag">Su nivel actual</span>{%- endif -%}
              <span class="brenson-eyebrow">Tier {{ t.nombre.value }} · {{ t.minimo_unidades.value }}+ unidades</span>
              <h3 style="margin:0; font-size: var(--brenson-text-xl)">{{ t.nombre.value }}</h3>
              <div class="brenson-tier__pct brenson-num">{{ t.descuento_pct.value | round }} %<small> descuento directo</small></div>
              <ul class="brenson-checklist" style="grid-template-columns:1fr">
                {%- for b in t.beneficios.value -%}<li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ b }}</li>{%- endfor -%}
              </ul>
              {%- if is_current -%}
                <p style="text-align:center; font-weight:700; color: var(--brenson-rojo); font-size: var(--brenson-text-sm); margin:0">Actualmente disfrutando este tier</p>
              {%- elsif forloop.index0 < current_idx -%}
                <p class="brenson-muted" style="text-align:center; font-size: var(--brenson-text-sm); margin:0">Nivel de entrada para empresas</p>
              {%- else -%}
                <a class="brenson-btn brenson-btn--outline brenson-btn--block" href="{% render 'brenson-whatsapp-link', context: 'b2b_ascenso' %}" target="_blank" rel="noopener">Consultar requisitos para ascender</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
  <script src="{{ 'brenson-b2b-dashboard.js' | asset_url }}" defer></script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Empresas · Dashboard",
  "tag": "div",
  "settings": [ { "type": "paragraph", "content": "Visible solo para clientes con acceso aprobado. Datos desde metafields del cliente y metaobjects de cotizaciones y unidades." } ],
  "blocks": [
    { "type": "documento", "name": "Documento descargable", "settings": [ { "type": "text", "id": "title", "label": "Título", "default": "Catálogo de flota" }, { "type": "url", "id": "file", "label": "URL del PDF" } ] }
  ],
  "presets": [ { "name": "Empresas · Dashboard" } ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
