{
  "sections": {
    "breadcrumb": { "type": "brenson-breadcrumb" },
    "main": {
      "type": "main-product",
      "blocks": {
        "certificado": { "type": "brenson_certificado" },
        "title": { "type": "title" },
        "subtitle": { "type": "text", "settings": { "text": "{{ product.metafields.brenson.descripcion_corta.value }}", "text_style": "body" } },
        "specs_clave": { "type": "brenson_specs_clave" },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        "precio_cuota": { "type": "brenson_precio" },
        "cta_whatsapp": { "type": "brenson_cta_whatsapp" },
        "cta_cotizar": { "type": "brenson_cta_cotizar" },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": false, "show_gift_card_recipient": false } },
        "micro_garantias": { "type": "brenson_micro_garantias" },
        "description": { "type": "description" }
      },
      "block_order": ["certificado", "title", "subtitle", "specs_clave", "variant_picker", "precio_cuota", "cta_whatsapp", "cta_cotizar", "buy_buttons", "micro_garantias", "description"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": true,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "simulador": {
      "type": "brenson-simulator",
      "settings": {
        "eyebrow": "Calculadora financiera",
        "title": "Simula tu cuota",
        "subtitle": "Elige cuota inicial y plazo. La cuota se calcula con la tasa de referencia de nuestro aliado financiero.",
        "cta_label": "Solicitar financiamiento",
        "dark": false
      }
    },
    "certificacion": {
      "type": "brenson-product-certification",
      "settings": {
        "eyebrow": "Inspección técnica certificada",
        "title": "Sello de confianza Brenson: 12 puntos de inspección",
        "text": "Cada vehículo pasa por 12 puntos de inspección técnica y prueba de ruta antes de ser entregado. Cero sorpresas, 100 % de confiabilidad."
      }
    },
    "specs": {
      "type": "brenson-product-specs",
      "settings": { "eyebrow": "Ficha técnica", "title": "Especificaciones técnicas" }
    },
    "garantia": {
      "type": "brenson-product-warranty",
      "settings": { "eyebrow": "Respaldo postventa directo", "title": "Garantía Brenson: transparente y sin letra chica", "show_shipping": true }
    },
    "resenas": {
      "type": "brenson-product-reviews",
      "blocks": {
        "r1": {
          "type": "resena",
          "settings": {
            "nombre": "Camilo Gómez R.",
            "rol": "Propietario verificado · Bogotá D.C.",
            "fecha_texto": "Hace 3 semanas",
            "texto": "La Brenson City 1500 me cambió los trayectos diarios de Suba a Chapinero. Antes gastaba 2 horas en trancón y ahora llego en 40 minutos en silencio absoluto. El baúl trasero de 28L es súper espacioso, cabe mi casco y el morral del portátil. La subo al apartamento sin problemas y la cargo en el tomacorriente común.",
            "avatar_color": "#1A1A1A"
          }
        },
        "r2": {
          "type": "resena",
          "settings": {
            "nombre": "Valentina Osorio M.",
            "rol": "Propietaria verificada · Medellín (El Poblado)",
            "fecha_texto": "Hace 1 mes",
            "texto": "Me daba susto la fuerza en lomas de Medellín pero responde con holgura en las subidas con dos personas. El proceso de financiación con Bancolombia a través del asesor de WhatsApp fue rapidísimo, en menos de 24 horas estaba aprobado. Excelente servicio postventa y entrega con su checklist firmado.",
            "avatar_color": "#EE0000"
          }
        }
      },
      "block_order": ["r1", "r2"],
      "settings": {
        "title": "Opiniones de compradores",
        "subtitle": "Propietarios en Colombia",
        "rating_avg": "4.8",
        "rating_count": 23,
        "pct_5": 87,
        "pct_4": 13,
        "pct_3": 0,
        "pct_2": 0,
        "pct_1": 0,
        "show_write_review": true,
        "write_review_label": "Escribir una opinión de compra"
      }
    },
    "faq": {
      "type": "brenson-faq",
      "settings": { "eyebrow": "Resolvemos tus dudas", "title": "Preguntas frecuentes", "categoria": "todas", "limit": 6, "show_cta": true }
    },
    "lead": {
      "type": "brenson-lead-form",
      "settings": {
        "tipo": "cotizacion",
        "eyebrow": "Solicita tu cotización",
        "title": "Un asesor te responde hoy",
        "text": "Déjanos tus datos y te enviamos la cotización de este vehículo con opciones de financiación.",
        "cta_label": "Solicitar cotización",
        "show_test_drive": true,
        "alt": true
      }
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "Otros modelos de la gama Brenson",
        "heading_size": "h2",
        "products_to_show": 3,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "sticky": { "type": "brenson-sticky-cta", "settings": {} },
    "exit": { "type": "brenson-exit-intent", "settings": { "eyebrow": "Antes de irte", "title": "Llévate la ficha técnica del {modelo}", "text": "Te enviamos la ficha técnica en PDF con specs, garantía y cuota estimada.", "cta_label": "Enviarme la ficha", "days": 7 } }
  },
  "order": ["breadcrumb", "main", "simulador", "certificacion", "specs", "garantia", "resenas", "faq", "lead", "related", "sticky", "exit"]
}
