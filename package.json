{
  "name": "brenson-ecosistema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ecosistema digital Brenson S.A.S.: tema Shopify (Dawn 16), backend serverless y Shopify Function B2B.",
  "scripts": {
    "theme:check": "shopify theme check --path brenson-theme",
    "theme:dev": "shopify theme dev --path brenson-theme --store $SHOPIFY_SHOP",
    "theme:push:staging": "shopify theme push --path brenson-theme --unpublished --theme \"Brenson Staging\" --store $SHOPIFY_SHOP",
    "definitions": "node scripts/create-definitions.mjs",
    "definitions:dry": "node scripts/create-definitions.mjs --dry-run",
    "import:mocks": "node scripts/import-mocks.mjs",
    "import:mocks:dry": "node scripts/import-mocks.mjs --dry-run",
    "check:mocks": "node scripts/check-mocks.mjs",
    "check:mocks:strict": "node scripts/check-mocks.mjs --strict",
    "services:test": "npm --prefix brenson-services test",
    "functions:test": "node --test brenson-b2b-functions/extensions/tier-discount/src/run.test.js",
    "test": "npm run services:test && npm run functions:test"
  }
}
